new file mode 100644
index 0000000..204f978
--- /dev/null
+++ b/zscaler/oneapisigning_test.go
@@ -0,0 +1,316 @@
+package zscaler
+
+import (
+	"context"
+	"crypto"
+	"crypto/rand"
+	"crypto/rsa"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/golang-jwt/jwt/v5"
+	"github.com/zscaler/zscaler-sdk-go/v3/zscaler/remotesign"
+)
+
+// rewriteTransport sends every request to the test server instead of to the
+// real Zscaler OAuth2 host, so the full authentication path can be exercised.
+type rewriteTransport struct {
+	target *url.URL
+}
+
+func (t rewriteTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	clone := req.Clone(req.Context())
+	clone.URL.Scheme = t.target.Scheme
+	clone.URL.Host = t.target.Host
+	return http.DefaultTransport.RoundTrip(clone)
+}
+
+type oneAPITestEnv struct {
+	key           *rsa.PrivateKey
+	vaultURL      string
+	authURL       string
+	vaultRequests int
+	lastForm      url.Values
+	assertionErr  error
+}
+
+// newOneAPITestEnv starts a fake Vault Transit engine and a fake Zscaler OAuth2
+// provider that only issues a token for a correctly signed client assertion.
+func newOneAPITestEnv(t *testing.T) *oneAPITestEnv {
+	t.Helper()
+	key, err := rsa.GenerateKey(rand.Reader, 2048)
+	if err != nil {
+		t.Fatalf("generating key: %v", err)
+	}
+	env := &oneAPITestEnv{key: key}
+
+	vault := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		env.vaultRequests++
+		var body struct {
+			Input string `json:"input"`
+		}
+		if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+			http.Error(w, err.Error(), http.StatusBadRequest)
+			return
+		}
+		if got := r.Header.Get("X-Vault-Token"); got != "hvs.test-token" {
+			w.WriteHeader(http.StatusForbidden)
+			_, _ = w.Write([]byte(`{"errors":["permission denied"]}`))
+			return
+		}
+		input, err := base64.StdEncoding.DecodeString(body.Input)
+		if err != nil {
+			http.Error(w, err.Error(), http.StatusBadRequest)
+			return
+		}
+		digest := sha256.Sum256(input)
+		signature, err := rsa.SignPKCS1v15(rand.Reader, key, crypto.SHA256, digest[:])
+		if err != nil {
+			http.Error(w, err.Error(), http.StatusInternalServerError)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_ = json.NewEncoder(w).Encode(map[string]interface{}{
+			"data": map[string]interface{}{"signature": "vault:v1:" + base64.StdEncoding.EncodeToString(signature)},
+		})
+	}))
+	t.Cleanup(vault.Close)
+
+	auth := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if err := r.ParseForm(); err != nil {
+			http.Error(w, err.Error(), http.StatusBadRequest)
+			return
+		}
+		env.lastForm = r.PostForm
+
+		claims := jwt.MapClaims{}
+		_, err := jwt.ParseWithClaims(r.PostForm.Get("client_assertion"), claims, func(*jwt.Token) (interface{}, error) {
+			return &key.PublicKey, nil
+		}, jwt.WithValidMethods([]string{"RS256"}), jwt.WithAudience("https://api.zscaler.com"), jwt.WithIssuer("test-client-id"))
+		if err != nil {
+			env.assertionErr = err
+			w.WriteHeader(http.StatusUnauthorized)
+			_, _ = w.Write([]byte(`{"error":"invalid_client"}`))
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_ = json.NewEncoder(w).Encode(map[string]interface{}{
+			"token_type":   "Bearer",
+			"access_token": "issued-access-token",
+			"expires_in":   "3600",
+		})
+	}))
+	t.Cleanup(auth.Close)
+
+	env.vaultURL = vault.URL + "/v1/transit/sign/zscaler-oneapi"
+	env.authURL = auth.URL
+	return env
+}
+
+func (e *oneAPITestEnv) configure(t *testing.T, setters ...ConfigSetter) *Configuration {
+	t.Helper()
+	cfg, err := NewConfiguration(setters...)
+	if err != nil {
+		t.Fatalf("NewConfiguration: %v", err)
+	}
+	target, err := url.Parse(e.authURL)
+	if err != nil {
+		t.Fatalf("parsing auth URL: %v", err)
+	}
+	cfg.HTTPClient = &http.Client{Transport: rewriteTransport{target: target}, Timeout: 10 * time.Second}
+	return cfg
+}
+
+func TestAuthenticateWithRemoteSigningService(t *testing.T) {
+	env := newOneAPITestEnv(t)
+
+	cfg := env.configure(t,
+		WithClientID("test-client-id"),
+		WithVanityDomain("acme"),
+		WithSigningConfig(remotesign.Config{
+			URL:   env.vaultURL,
+			Token: "hvs.test-token",
+		}),
+	)
+
+	if cfg.Signer == nil {
+		t.Fatal("NewConfiguration did not build a signer")
+	}
+
+	token, err := Authenticate(context.Background(), cfg, cfg.Logger)
+	if err != nil {
+		t.Fatalf("Authenticate: %v (assertion error: %v)", err, env.assertionErr)
+	}
+	if token.AccessToken != "issued-access-token" {
+		t.Errorf("access token = %q, want issued-access-token", token.AccessToken)
+	}
+	// Without an expiry the renewal ticker has nothing to schedule against.
+	if token.Expiry.IsZero() {
+		t.Error("token expiry was not set from expires_in")
+	}
+	if remaining := time.Until(token.Expiry); remaining < 59*time.Minute || remaining > 61*time.Minute {
+		t.Errorf("token expires in %s, want about an hour", remaining)
+	}
+
+	if got := env.lastForm.Get("client_assertion_type"); got != "urn:ietf:params:oauth:client-assertion-type:jwt-bearer" {
+		t.Errorf("client_assertion_type = %q", got)
+	}
+	if got := env.lastForm.Get("grant_type"); got != "client_credentials" {
+		t.Errorf("grant_type = %q, want client_credentials", got)
+	}
+	if got := env.lastForm.Get("client_id"); got != "test-client-id" {
+		t.Errorf("client_id = %q, want test-client-id", got)
+	}
+	if env.lastForm.Get("client_secret") != "" {
+		t.Error("no client secret must be sent when signing remotely")
+	}
+	if env.vaultRequests != 1 {
+		t.Errorf("Vault was called %d times, want 1", env.vaultRequests)
+	}
+}
+
+func TestAuthenticateWithSigningURLSetter(t *testing.T) {
+	env := newOneAPITestEnv(t)
+
+	cfg := env.configure(t,
+		WithClientID("test-client-id"),
+		WithVanityDomain("acme"),
+		WithSigningURL(env.vaultURL),
+		WithSigningConfig(remotesign.Config{URL: env.vaultURL, Token: "hvs.test-token"}),
+	)
+	if _, err := Authenticate(context.Background(), cfg, cfg.Logger); err != nil {
+		t.Fatalf("Authenticate: %v", err)
+	}
+}
+
+// stubSigner signs locally, standing in for a caller supplied KMS client.
+type stubSigner struct {
+	key    *rsa.PrivateKey
+	called int
+}
+
+func (s *stubSigner) Sign(_ context.Context, signingInput []byte) ([]byte, error) {
+	s.called++
+	digest := sha256.Sum256(signingInput)
+	return rsa.SignPKCS1v15(rand.Reader, s.key, crypto.SHA256, digest[:])
+}
+
+func TestCallerSuppliedSignerTakesPrecedenceOverPrivateKey(t *testing.T) {
+	env := newOneAPITestEnv(t)
+	signer := &stubSigner{key: env.key}
+
+	cfg := env.configure(t,
+		WithClientID("test-client-id"),
+		WithVanityDomain("acme"),
+		WithSigner(signer),
+		func(c *Configuration) {
+			// A stale private key in the environment must not win over an
+			// explicitly configured signer.
+			c.Zscaler.Client.PrivateKey = []byte("-----BEGIN RSA PRIVATE KEY-----\nnot a key\n-----END RSA PRIVATE KEY-----")
+		},
+	)
+
+	if _, err := Authenticate(context.Background(), cfg, cfg.Logger); err != nil {
+		t.Fatalf("Authenticate: %v (assertion error: %v)", err, env.assertionErr)
+	}
+	if signer.called != 1 {
+		t.Errorf("signer called %d times, want 1", signer.called)
+	}
+	if env.vaultRequests != 0 {
+		t.Errorf("Vault was called %d times, want 0", env.vaultRequests)
+	}
+}
+
+func TestAuthenticateReportsSigningFailures(t *testing.T) {
+	env := newOneAPITestEnv(t)
+
+	cfg := env.configure(t,
+		WithClientID("test-client-id"),
+		WithVanityDomain("acme"),
+		WithSigningConfig(remotesign.Config{URL: env.vaultURL, Token: "hvs.wrong-token"}),
+	)
+
+	_, err := Authenticate(context.Background(), cfg, cfg.Logger)
+	if err == nil {
+		t.Fatal("expected an error when the signing service rejects the client")
+	}
+	if !strings.Contains(err.Error(), "permission denied") {
+		t.Errorf("error %q does not explain that signing failed", err)
+	}
+}
+
+func TestNewConfigurationRejectsInvalidSigningConfiguration(t *testing.T) {
+	_, err := NewConfiguration(
+		WithClientID("test-client-id"),
+		WithVanityDomain("acme"),
+		WithSigningConfig(remotesign.Config{URL: "vault.example.com/v1/transit/sign/key"}),
+	)
+	if err == nil {
+		t.Fatal("expected NewConfiguration to reject a relative signing URL")
+	}
+	if !strings.Contains(err.Error(), "absolute http(s) URL") {
+		t.Errorf("error %q does not explain the problem", err)
+	}
+}
+
+func TestAuthenticateStillRequiresCredentials(t *testing.T) {
+	cfg, err := NewConfiguration(WithClientID("test-client-id"), WithVanityDomain("acme"))
+	if err != nil {
+		t.Fatalf("NewConfiguration: %v", err)
+	}
+	if _, err := Authenticate(context.Background(), cfg, cfg.Logger); err == nil || !strings.Contains(err.Error(), "no client credentials") {
+		t.Fatalf("error = %v, want a missing credentials error", err)
+	}
+}
+
+func TestRemoteSigningConfigPrecedence(t *testing.T) {
+	cfg, err := NewConfiguration(
+		WithClientID("test-client-id"),
+		WithVanityDomain("acme"),
+		func(c *Configuration) {
+			// Values that would come from zscaler.yaml or the environment.
+			c.Zscaler.Client.Signing.URL = "https://vault.example.com/v1/transit/sign/from-file"
+			c.Zscaler.Client.Signing.Namespace = "admin"
+			c.Zscaler.Client.Signing.KeyVersion = 4
+			c.Zscaler.Client.Signing.Token = "hvs.from-file"
+		},
+		// Values set programmatically win field by field.
+		WithSigningConfig(remotesign.Config{URL: "https://vault.example.com/v1/transit/sign/explicit", Token: "hvs.explicit"}),
+	)
+	if err != nil {
+		t.Fatalf("NewConfiguration: %v", err)
+	}
+
+	if got := cfg.SigningConfig.URL; got != "https://vault.example.com/v1/transit/sign/explicit" {
+		t.Errorf("URL = %q, want the programmatic value", got)
+	}
+	if got := cfg.SigningConfig.Token; got != "hvs.explicit" {
+		t.Errorf("Token = %q, want the programmatic value", got)
+	}
+	if got := cfg.SigningConfig.Namespace; got != "admin" {
+		t.Errorf("Namespace = %q, want the value from the file", got)
+	}
+	if got := cfg.SigningConfig.KeyVersion; got != 4 {
+		t.Errorf("KeyVersion = %d, want the value from the file", got)
+	}
+	if cfg.Signer == nil {
+		t.Error("no signer was built")
+	}
+}
+
+func TestNoSignerWithoutSigningConfiguration(t *testing.T) {
+	cfg, err := NewConfiguration(WithClientID("id"), WithClientSecret("secret"), WithVanityDomain("acme"))
+	if err != nil {
+		t.Fatalf("NewConfiguration: %v", err)
+	}
+	if cfg.Signer != nil {
+		t.Error("a signer must not be built when no signing service is configured")
+	}
+}
diff --git a/zscaler/remotesign/http.go b/zscaler/remotesign/http.go
new file mode 100644
index 0000000..85c1588
--- /dev/null
+++ b/zscaler/remotesign/http.go
@@ -0,0 +1,266 @@
+package remotesign
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"strings"
+)
+
+// httpSigner posts to a generic JSON signing endpoint.
+type httpSigner struct {
+	url            string
+	keyID          string
+	requestFormat  string
+	responseFormat string
+	signatureField string
+	headers        map[string]string
+	staticToken    string
+	auth           *vaultAuth
+	client         *http.Client
+	logger         Logger
+}
+
+func newHTTPSigner(cfg Config) (Signer, error) {
+	requestFormat := strings.ToLower(strings.TrimSpace(cfg.RequestFormat))
+	if requestFormat == "" {
+		requestFormat = RequestFormatGeneric
+	}
+	if requestFormat != RequestFormatGeneric && requestFormat != RequestFormatAzureKeyVault {
+		return nil, fmt.Errorf("remotesign: unsupported signing request format %q (want %q or %q)", requestFormat, RequestFormatGeneric, RequestFormatAzureKeyVault)
+	}
+
+	responseFormat := strings.ToLower(strings.TrimSpace(cfg.ResponseFormat))
+	if responseFormat == "" {
+		responseFormat = ResponseFormatSignature
+	}
+	if responseFormat != ResponseFormatSignature && responseFormat != ResponseFormatJWT {
+		return nil, fmt.Errorf("remotesign: unsupported signing response format %q (want %q or %q)", responseFormat, ResponseFormatSignature, ResponseFormatJWT)
+	}
+	if responseFormat == ResponseFormatJWT && requestFormat == RequestFormatAzureKeyVault {
+		return nil, fmt.Errorf("remotesign: response format %q is not compatible with request format %q", ResponseFormatJWT, RequestFormatAzureKeyVault)
+	}
+
+	signer := &httpSigner{
+		url:            cfg.URL,
+		keyID:          cfg.KeyID,
+		requestFormat:  requestFormat,
+		responseFormat: responseFormat,
+		signatureField: strings.TrimSpace(cfg.SignatureField),
+		headers:        cfg.Headers,
+		client:         cfg.httpClient(),
+		logger:         cfg.logger(),
+	}
+
+	switch method := cfg.resolveAuthMethod(); method {
+	case AuthMethodNone:
+	case AuthMethodToken:
+		if cfg.Token == "" {
+			return nil, fmt.Errorf("remotesign: signing auth method %q requires a token", AuthMethodToken)
+		}
+		signer.staticToken = cfg.Token
+	default:
+		// Vault login methods are usable for non-Transit endpoints too, e.g. a
+		// signing gateway that validates Vault tokens.
+		address, err := vaultAddress(cfg)
+		if err != nil {
+			return nil, err
+		}
+		auth, err := newVaultAuth(cfg, address)
+		if err != nil {
+			return nil, err
+		}
+		signer.auth = auth
+	}
+
+	// Only a signer that is actually configured to return a whole assertion may
+	// satisfy AssertionSigner; otherwise BuildAssertion would take the assertion
+	// path for every HTTP signer.
+	if responseFormat == ResponseFormatJWT {
+		return &httpAssertionSigner{httpSigner: signer}, nil
+	}
+	return signer, nil
+}
+
+// httpAssertionSigner is an httpSigner whose endpoint returns a complete,
+// signed client assertion instead of a bare signature.
+type httpAssertionSigner struct {
+	*httpSigner
+}
+
+// signRequest is the generic request body. Both the raw signing input and its
+// SHA-256 digest are provided so an endpoint can sign whichever it expects,
+// and so it can inspect exactly what it is being asked to sign.
+type signRequest struct {
+	Algorithm       string                 `json:"alg"`
+	KeyID           string                 `json:"key_id,omitempty"`
+	SigningInput    string                 `json:"signing_input,omitempty"`
+	Digest          string                 `json:"digest,omitempty"`
+	DigestAlgorithm string                 `json:"digest_algorithm,omitempty"`
+	Claims          map[string]interface{} `json:"claims,omitempty"`
+}
+
+// keyVaultSignRequest is the Azure Key Vault / Managed HSM "sign" body.
+type keyVaultSignRequest struct {
+	Algorithm string `json:"alg"`
+	Value     string `json:"value"`
+}
+
+func (h *httpSigner) Sign(ctx context.Context, signingInput []byte) ([]byte, error) {
+	digest := sha256.Sum256(signingInput)
+
+	var payload interface{}
+	switch h.requestFormat {
+	case RequestFormatAzureKeyVault:
+		payload = keyVaultSignRequest{
+			Algorithm: "RS256",
+			Value:     base64.RawURLEncoding.EncodeToString(digest[:]),
+		}
+	default:
+		payload = signRequest{
+			Algorithm:       "RS256",
+			KeyID:           h.keyID,
+			SigningInput:    base64.RawURLEncoding.EncodeToString(signingInput),
+			Digest:          base64.RawURLEncoding.EncodeToString(digest[:]),
+			DigestAlgorithm: "SHA-256",
+		}
+	}
+
+	body, err := h.post(ctx, payload)
+	if err != nil {
+		return nil, err
+	}
+	value, err := h.extract(body, signatureFieldCandidates)
+	if err != nil {
+		return nil, err
+	}
+	return decodeSignature(value)
+}
+
+// SignAssertion is used when the endpoint returns a complete assertion rather
+// than a bare signature.
+func (h *httpAssertionSigner) SignAssertion(ctx context.Context, claims map[string]interface{}, keyID string) (string, error) {
+	if keyID == "" {
+		keyID = h.keyID
+	}
+	body, err := h.post(ctx, signRequest{Algorithm: "RS256", KeyID: keyID, Claims: claims})
+	if err != nil {
+		return "", err
+	}
+	value, err := h.extract(body, assertionFieldCandidates)
+	if err != nil {
+		return "", err
+	}
+	return strings.Trim(strings.TrimSpace(value), `"`), nil
+}
+
+func (h *httpSigner) post(ctx context.Context, payload interface{}) ([]byte, error) {
+	encoded, err := json.Marshal(payload)
+	if err != nil {
+		return nil, fmt.Errorf("remotesign: encoding signing request: %w", err)
+	}
+
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, h.url, bytes.NewReader(encoded))
+	if err != nil {
+		return nil, fmt.Errorf("remotesign: building signing request: %w", err)
+	}
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("Accept", "application/json")
+
+	if h.auth != nil {
+		token, err := h.auth.token(ctx, false)
+		if err != nil {
+			return nil, err
+		}
+		if token != "" {
+			req.Header.Set("X-Vault-Token", token)
+		}
+	} else if h.staticToken != "" {
+		req.Header.Set("Authorization", "Bearer "+h.staticToken)
+	}
+	// Explicit headers win over anything derived from the auth settings.
+	for name, value := range h.headers {
+		req.Header.Set(name, value)
+	}
+
+	resp, err := h.client.Do(req)
+	if err != nil {
+		return nil, fmt.Errorf("remotesign: calling signing endpoint %s: %w", h.url, err)
+	}
+	defer resp.Body.Close()
+
+	body, err := io.ReadAll(resp.Body)
+	if err != nil {
+		return nil, fmt.Errorf("remotesign: reading signing response: %w", err)
+	}
+	if resp.StatusCode > 299 {
+		return nil, fmt.Errorf("remotesign: signing endpoint %s returned HTTP %d: %s", h.url, resp.StatusCode, truncate(strings.TrimSpace(string(body)), 256))
+	}
+	return body, nil
+}
+
+var (
+	signatureFieldCandidates = []string{"signature", "data.signature", "value", "result"}
+	assertionFieldCandidates = []string{"assertion", "client_assertion", "jwt", "token", "data.assertion", "value"}
+)
+
+// extract pulls the interesting string out of a signing response. A response
+// that is not JSON is taken verbatim, which covers endpoints that answer with a
+// bare base64 string.
+func (h *httpSigner) extract(body []byte, candidates []string) (string, error) {
+	trimmed := strings.TrimSpace(string(body))
+	if trimmed == "" {
+		return "", fmt.Errorf("remotesign: signing endpoint returned an empty body")
+	}
+
+	var parsed interface{}
+	if err := json.Unmarshal(body, &parsed); err != nil {
+		return trimmed, nil
+	}
+	if s, ok := parsed.(string); ok {
+		return s, nil
+	}
+	document, ok := parsed.(map[string]interface{})
+	if !ok {
+		return "", fmt.Errorf("remotesign: unexpected signing response: %s", truncate(trimmed, 256))
+	}
+
+	if h.signatureField != "" {
+		value, found := lookupPath(document, h.signatureField)
+		if !found {
+			return "", fmt.Errorf("remotesign: signing response has no field %q: %s", h.signatureField, truncate(trimmed, 256))
+		}
+		return value, nil
+	}
+	for _, candidate := range candidates {
+		if value, found := lookupPath(document, candidate); found {
+			return value, nil
+		}
+	}
+	return "", fmt.Errorf("remotesign: could not find a signature in the signing response (looked for %s): %s", strings.Join(candidates, ", "), truncate(trimmed, 256))
+}
+
+// lookupPath resolves a dotted path such as "data.signature" to a string value.
+func lookupPath(document map[string]interface{}, path string) (string, bool) {
+	var current interface{} = document
+	for _, segment := range strings.Split(path, ".") {
+		node, ok := current.(map[string]interface{})
+		if !ok {
+			return "", false
+		}
+		current, ok = node[segment]
+		if !ok {
+			return "", false
+		}
+	}
+	value, ok := current.(string)
+	if !ok || value == "" {
+		return "", false
+	}
+	return value, true
+}
diff --git a/zscaler/remotesign/http_test.go b/zscaler/remotesign/http_test.go
new file mode 100644
index 0000000..488a90a
--- /dev/null
+++ b/zscaler/remotesign/http_test.go
@@ -0,0 +1,347 @@
+package remotesign
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/golang-jwt/jwt/v5"
+)
+
+// httpSignerServer records the last request and answers with a signature
+// rendered by the responder.
+type httpSignerServer struct {
+	*httptest.Server
+	LastBody    map[string]interface{}
+	LastHeaders http.Header
+	Status      int
+	Responder   func(signature []byte, body map[string]interface{}) (contentType string, payload string)
+}
+
+func newHTTPSignerServer(t *testing.T) *httpSignerServer {
+	t.Helper()
+	server := &httpSignerServer{Status: http.StatusOK}
+	server.Responder = func(signature []byte, _ map[string]interface{}) (string, string) {
+		return "application/json", fmt.Sprintf(`{"signature":%q}`, base64.RawURLEncoding.EncodeToString(signature))
+	}
+	server.Server = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		raw, _ := io.ReadAll(r.Body)
+		var body map[string]interface{}
+		_ = json.Unmarshal(raw, &body)
+		server.LastBody = body
+		server.LastHeaders = r.Header.Clone()
+
+		if server.Status != http.StatusOK {
+			w.WriteHeader(server.Status)
+			_, _ = w.Write([]byte(`{"error":"signing refused"}`))
+			return
+		}
+
+		signingInput := decodeSigningInput(t, body)
+		contentType, payload := server.Responder(signRS256(t, signingInput), body)
+		w.Header().Set("Content-Type", contentType)
+		_, _ = w.Write([]byte(payload))
+	}))
+	t.Cleanup(server.Close)
+	return server
+}
+
+// decodeSigningInput reconstructs what the endpoint was asked to sign. The
+// generic format carries the signing input itself; the Key Vault format carries
+// only its digest, so those responders sign the digest directly.
+func decodeSigningInput(t *testing.T, body map[string]interface{}) []byte {
+	t.Helper()
+	if encoded := asString(body["signing_input"]); encoded != "" {
+		decoded, err := base64.RawURLEncoding.DecodeString(encoded)
+		if err != nil {
+			t.Fatalf("signing_input is not raw base64url: %v", err)
+		}
+		return decoded
+	}
+	return nil
+}
+
+func TestGenericHTTPSignerRoundTrip(t *testing.T) {
+	server := newHTTPSignerServer(t)
+
+	signer, err := New(Config{URL: server.URL, Token: "signing-service-token", KeyID: "key-1"})
+	if err != nil {
+		t.Fatalf("New: %v", err)
+	}
+
+	assertion, err := BuildAssertion(context.Background(), signer, AssertionParams{
+		ClientID: "client-123",
+		Audience: "https://api.zscaler.com",
+		KeyID:    "key-1",
+	})
+	if err != nil {
+		t.Fatalf("BuildAssertion: %v", err)
+	}
+	verifyAssertion(t, assertion)
+
+	if got := asString(server.LastBody["alg"]); got != "RS256" {
+		t.Errorf("alg = %q, want RS256", got)
+	}
+	if got := asString(server.LastBody["key_id"]); got != "key-1" {
+		t.Errorf("key_id = %q, want key-1", got)
+	}
+	if got := server.LastHeaders.Get("Authorization"); got != "Bearer signing-service-token" {
+		t.Errorf("Authorization = %q, want a bearer token", got)
+	}
+
+	// The digest must match the signing input the endpoint was handed.
+	signingInput := decodeSigningInput(t, server.LastBody)
+	wantDigest := sha256.Sum256(signingInput)
+	if got := asString(server.LastBody["digest"]); got != base64.RawURLEncoding.EncodeToString(wantDigest[:]) {
+		t.Error("digest does not match signing_input")
+	}
+	if want := assertion[:strings.LastIndex(assertion, ".")]; string(signingInput) != want {
+		t.Errorf("signed input = %q, want %q", signingInput, want)
+	}
+}
+
+func TestAzureKeyVaultRequestFormat(t *testing.T) {
+	server := newHTTPSignerServer(t)
+	// Key Vault signs the digest it is given and answers {"kid":...,"value":...}.
+	server.Responder = func(_ []byte, body map[string]interface{}) (string, string) {
+		digest, err := base64.RawURLEncoding.DecodeString(asString(body["value"]))
+		if err != nil {
+			t.Fatalf("value is not raw base64url: %v", err)
+		}
+		signature := signPrehashedRS256(t, digest)
+		return "application/json", fmt.Sprintf(`{"kid":"https://kv.vault.azure.net/keys/k/1","value":%q}`,
+			base64.RawURLEncoding.EncodeToString(signature))
+	}
+
+	signer, err := New(Config{
+		URL:           server.URL + "/keys/zscaler/1234/sign?api-version=7.4",
+		Mode:          ModeHTTP,
+		RequestFormat: RequestFormatAzureKeyVault,
+		Token:         "aad-access-token",
+	})
+	if err != nil {
+		t.Fatalf("New: %v", err)
+	}
+
+	assertion, err := BuildAssertion(context.Background(), signer, AssertionParams{
+		ClientID: "client-123",
+		Audience: "https://api.zscaler.com",
+	})
+	if err != nil {
+		t.Fatalf("BuildAssertion: %v", err)
+	}
+	verifyAssertion(t, assertion)
+
+	if _, ok := server.LastBody["signing_input"]; ok {
+		t.Error("the Key Vault request body must carry only alg and value")
+	}
+	if got := asString(server.LastBody["alg"]); got != "RS256" {
+		t.Errorf("alg = %q, want RS256", got)
+	}
+}
+
+func TestSignatureEncodingsAndFieldLookup(t *testing.T) {
+	cases := []struct {
+		name           string
+		signatureField string
+		responder      func(signature []byte, body map[string]interface{}) (string, string)
+	}{
+		{
+			name: "nested data.signature with a vault prefix",
+			responder: func(signature []byte, _ map[string]interface{}) (string, string) {
+				return "application/json", fmt.Sprintf(`{"data":{"signature":"vault:v2:%s"}}`, base64.StdEncoding.EncodeToString(signature))
+			},
+		},
+		{
+			name: "standard base64 in value",
+			responder: func(signature []byte, _ map[string]interface{}) (string, string) {
+				return "application/json", fmt.Sprintf(`{"value":%q}`, base64.StdEncoding.EncodeToString(signature))
+			},
+		},
+		{
+			name: "bare base64 body",
+			responder: func(signature []byte, _ map[string]interface{}) (string, string) {
+				return "text/plain", base64.StdEncoding.EncodeToString(signature)
+			},
+		},
+		{
+			name: "hex body",
+			responder: func(signature []byte, _ map[string]interface{}) (string, string) {
+				return "text/plain", fmt.Sprintf("%x", signature)
+			},
+		},
+		{
+			name:           "custom field path",
+			signatureField: "result.inner.sig",
+			responder: func(signature []byte, _ map[string]interface{}) (string, string) {
+				return "application/json", fmt.Sprintf(`{"result":{"inner":{"sig":%q}}}`, base64.RawURLEncoding.EncodeToString(signature))
+			},
+		},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			server := newHTTPSignerServer(t)
+			server.Responder = tc.responder
+
+			signer, err := New(Config{URL: server.URL, SignatureField: tc.signatureField})
+			if err != nil {
+				t.Fatalf("New: %v", err)
+			}
+			assertion, err := BuildAssertion(context.Background(), signer, AssertionParams{
+				ClientID: "client-123",
+				Audience: "https://api.zscaler.com",
+			})
+			if err != nil {
+				t.Fatalf("BuildAssertion: %v", err)
+			}
+			verifyAssertion(t, assertion)
+		})
+	}
+}
+
+func TestAssertionResponseFormat(t *testing.T) {
+	var seen map[string]interface{}
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		raw, _ := io.ReadAll(r.Body)
+		_ = json.Unmarshal(raw, &seen)
+
+		claims := jwt.MapClaims{}
+		for name, value := range seen["claims"].(map[string]interface{}) {
+			claims[name] = value
+		}
+		token := jwt.NewWithClaims(jwt.SigningMethodRS256, claims)
+		signed, err := token.SignedString(signingKey(t))
+		if err != nil {
+			t.Errorf("signing assertion: %v", err)
+		}
+		writeJSON(w, http.StatusOK, map[string]interface{}{"assertion": signed})
+	}))
+	t.Cleanup(server.Close)
+
+	signer, err := New(Config{URL: server.URL, ResponseFormat: ResponseFormatJWT})
+	if err != nil {
+		t.Fatalf("New: %v", err)
+	}
+	assertion, err := BuildAssertion(context.Background(), signer, AssertionParams{
+		ClientID: "client-123",
+		Audience: "https://api.zscaler.com",
+	})
+	if err != nil {
+		t.Fatalf("BuildAssertion: %v", err)
+	}
+
+	claims := verifyAssertion(t, assertion)
+	if got, _ := claims["iss"].(string); got != "client-123" {
+		t.Errorf("iss = %q, want client-123", got)
+	}
+	if _, ok := seen["signing_input"]; ok {
+		t.Error("the assertion request must send claims, not a signing input")
+	}
+}
+
+func TestHTTPSignerErrorPaths(t *testing.T) {
+	t.Run("http error is surfaced", func(t *testing.T) {
+		server := newHTTPSignerServer(t)
+		server.Status = http.StatusForbidden
+
+		signer, _ := New(Config{URL: server.URL})
+		_, err := signer.Sign(context.Background(), []byte("header.payload"))
+		if err == nil || !strings.Contains(err.Error(), "403") {
+			t.Fatalf("error = %v, want an HTTP 403 error", err)
+		}
+	})
+
+	t.Run("missing signature field", func(t *testing.T) {
+		server := newHTTPSignerServer(t)
+		server.Responder = func([]byte, map[string]interface{}) (string, string) {
+			return "application/json", `{"unexpected":"shape"}`
+		}
+		signer, _ := New(Config{URL: server.URL})
+		_, err := signer.Sign(context.Background(), []byte("header.payload"))
+		if err == nil || !strings.Contains(err.Error(), "could not find a signature") {
+			t.Fatalf("error = %v, want a missing signature error", err)
+		}
+	})
+
+	t.Run("undecodable signature", func(t *testing.T) {
+		server := newHTTPSignerServer(t)
+		server.Responder = func([]byte, map[string]interface{}) (string, string) {
+			return "application/json", `{"signature":"not a signature!!"}`
+		}
+		signer, _ := New(Config{URL: server.URL})
+		_, err := signer.Sign(context.Background(), []byte("header.payload"))
+		if err == nil || !strings.Contains(err.Error(), "could not decode signature") {
+			t.Fatalf("error = %v, want a decoding error", err)
+		}
+	})
+
+	t.Run("empty body", func(t *testing.T) {
+		server := newHTTPSignerServer(t)
+		server.Responder = func([]byte, map[string]interface{}) (string, string) {
+			return "text/plain", ""
+		}
+		signer, _ := New(Config{URL: server.URL})
+		_, err := signer.Sign(context.Background(), []byte("header.payload"))
+		if err == nil || !strings.Contains(err.Error(), "empty body") {
+			t.Fatalf("error = %v, want an empty body error", err)
+		}
+	})
+
+	t.Run("incompatible formats", func(t *testing.T) {
+		_, err := New(Config{URL: "https://kms.example.com/sign", RequestFormat: RequestFormatAzureKeyVault, ResponseFormat: ResponseFormatJWT})
+		if err == nil || !strings.Contains(err.Error(), "not compatible") {
+			t.Fatalf("error = %v, want an incompatible format error", err)
+		}
+	})
+
+	t.Run("unknown request format", func(t *testing.T) {
+		_, err := New(Config{URL: "https://kms.example.com/sign", RequestFormat: "protobuf"})
+		if err == nil || !strings.Contains(err.Error(), "unsupported signing request format") {
+			t.Fatalf("error = %v, want an unsupported format error", err)
+		}
+	})
+}
+
+func TestExplicitHeadersOverrideDerivedAuthHeader(t *testing.T) {
+	server := newHTTPSignerServer(t)
+	signer, err := New(Config{
+		URL:     server.URL,
+		Token:   "bearer-token",
+		Headers: map[string]string{"Authorization": "Basic Zm9vOmJhcg=="},
+	})
+	if err != nil {
+		t.Fatalf("New: %v", err)
+	}
+	if _, err := signer.Sign(context.Background(), []byte("header.payload")); err != nil {
+		t.Fatalf("Sign: %v", err)
+	}
+	if got := server.LastHeaders.Get("Authorization"); got != "Basic Zm9vOmJhcg==" {
+		t.Errorf("Authorization = %q, want the explicitly configured header", got)
+	}
+}
+
+func TestBuildAssertionValidation(t *testing.T) {
+	server := newHTTPSignerServer(t)
+	signer, _ := New(Config{URL: server.URL})
+
+	if _, err := BuildAssertion(context.Background(), nil, AssertionParams{ClientID: "c", Audience: "a"}); err == nil {
+		t.Error("expected an error without a signer")
+	}
+	if _, err := BuildAssertion(context.Background(), signer, AssertionParams{Audience: "a"}); err == nil {
+		t.Error("expected an error without a client ID")
+	}
+	if _, err := BuildAssertion(context.Background(), signer, AssertionParams{ClientID: "c"}); err == nil {
+		t.Error("expected an error without an audience")
+	}
+	if _, err := New(Config{}); err == nil {
+		t.Error("expected an error without a signing URL")
+	}
+}
