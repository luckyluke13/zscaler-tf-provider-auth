diff --git a/zscaler/oneapisigning.go b/zscaler/oneapisigning.go
new file mode 100644
index 0000000..da40815
--- /dev/null
+++ b/zscaler/oneapisigning.go
@@ -0,0 +1,201 @@
+package zscaler
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/google/uuid"
+	"github.com/zscaler/zscaler-sdk-go/v3/logger"
+	"github.com/zscaler/zscaler-sdk-go/v3/zscaler/remotesign"
+)
+
+// oneAPIAudience is the audience claim expected by the Zscaler OAuth2 provider.
+const oneAPIAudience = "https://api.zscaler.com"
+
+// remoteSigningConfig merges the programmatic signing configuration with the
+// values read from zscaler.yaml and the environment. Programmatic values win.
+func remoteSigningConfig(cfg *Configuration) remotesign.Config {
+	merged := cfg.SigningConfig
+	fromFile := cfg.Zscaler.Client.Signing
+
+	firstNonEmpty := func(values ...string) string {
+		for _, value := range values {
+			if strings.TrimSpace(value) != "" {
+				return value
+			}
+		}
+		return ""
+	}
+
+	merged.URL = firstNonEmpty(merged.URL, fromFile.URL)
+	merged.Mode = firstNonEmpty(merged.Mode, fromFile.Mode)
+	merged.KeyID = firstNonEmpty(merged.KeyID, fromFile.KeyID)
+	merged.Token = firstNonEmpty(merged.Token, fromFile.Token)
+	merged.AuthMethod = firstNonEmpty(merged.AuthMethod, fromFile.AuthMethod)
+	merged.AuthMount = firstNonEmpty(merged.AuthMount, fromFile.AuthMount)
+	merged.Role = firstNonEmpty(merged.Role, fromFile.Role)
+	merged.JWT = firstNonEmpty(merged.JWT, fromFile.JWT)
+	merged.JWTTokenFile = firstNonEmpty(merged.JWTTokenFile, fromFile.JWTTokenFile)
+	merged.RoleID = firstNonEmpty(merged.RoleID, fromFile.RoleID)
+	merged.SecretID = firstNonEmpty(merged.SecretID, fromFile.SecretID)
+	merged.Namespace = firstNonEmpty(merged.Namespace, fromFile.Namespace)
+	merged.VaultAddress = firstNonEmpty(merged.VaultAddress, fromFile.VaultAddress)
+	merged.RequestFormat = firstNonEmpty(merged.RequestFormat, fromFile.RequestFormat)
+	merged.ResponseFormat = firstNonEmpty(merged.ResponseFormat, fromFile.ResponseFormat)
+	merged.SignatureField = firstNonEmpty(merged.SignatureField, fromFile.SignatureField)
+
+	if merged.KeyVersion == 0 {
+		merged.KeyVersion = fromFile.KeyVersion
+	}
+	if merged.RequestTimeout <= 0 {
+		merged.RequestTimeout = fromFile.RequestTimeout
+	}
+	if merged.RequestTimeout <= 0 {
+		merged.RequestTimeout = cfg.Zscaler.Client.RequestTimeout
+	}
+	if len(merged.Headers) == 0 {
+		merged.Headers = fromFile.Headers
+	}
+	if merged.Logger == nil {
+		merged.Logger = cfg.Logger
+	}
+	return merged
+}
+
+// initRemoteSigner builds the remote signer, if one was configured. It runs
+// after all ConfigSetters have been applied so that configuration errors are
+// reported when the client is created rather than on the first API call.
+func initRemoteSigner(cfg *Configuration) error {
+	merged := remoteSigningConfig(cfg)
+	cfg.SigningConfig = merged
+
+	if cfg.Signer != nil || !merged.IsConfigured() {
+		return nil
+	}
+	signer, err := remotesign.New(merged)
+	if err != nil {
+		return err
+	}
+	cfg.Signer = signer
+	cfg.Logger.Printf("[DEBUG] remote client assertion signing enabled (%s)", merged.URL)
+	return nil
+}
+
+// authenticateWithSigner performs the OAuth2 client credentials flow with a JWT
+// client assertion whose signature is produced by the remote signing service.
+// The private key stays in the KMS/HSM that holds it.
+func authenticateWithSigner(ctx context.Context, cfg *Configuration, l logger.Logger) (*AuthToken, error) {
+	creds := cfg.Zscaler.Client
+	if creds.ClientID == "" {
+		return nil, errors.New("client ID is missing")
+	}
+	if creds.VanityDomain == "" {
+		return nil, errors.New("vanity domain is missing")
+	}
+
+	assertion, err := remotesign.BuildAssertion(ctx, cfg.Signer, remotesign.AssertionParams{
+		ClientID: creds.ClientID,
+		Audience: oneAPIAudience,
+		KeyID:    cfg.SigningConfig.KeyID,
+	})
+	if err != nil {
+		return nil, fmt.Errorf("failed to sign the client assertion for %s: %w", creds.ClientID, err)
+	}
+
+	formData := url.Values{
+		"grant_type":            {"client_credentials"},
+		"client_id":             {creds.ClientID},
+		"client_assertion":      {assertion},
+		"client_assertion_type": {"urn:ietf:params:oauth:client-assertion-type:jwt-bearer"},
+		"audience":              {oneAPIAudience},
+	}
+
+	return postTokenRequest(ctx, cfg, l, getAuthURL(creds.VanityDomain, creds.Cloud), formData)
+}
+
+// postTokenRequest exchanges an OAuth2 form payload for an AuthToken.
+func postTokenRequest(ctx context.Context, cfg *Configuration, l logger.Logger, authURL string, formData url.Values) (*AuthToken, error) {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, authURL, strings.NewReader(formData.Encode()))
+	if err != nil {
+		return nil, fmt.Errorf("failed to build the OAuth2 token request: %w", err)
+	}
+	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+	req.Header.Set("User-Agent", cfg.UserAgent)
+
+	if l != nil {
+		logger.LogRequest(l, req, uuid.NewString(), nil, false)
+	}
+
+	resp, err := cfg.HTTPClient.Do(req)
+	if err != nil {
+		return nil, fmt.Errorf("failed to obtain an OAuth2 token: %w", err)
+	}
+	defer resp.Body.Close()
+
+	body, err := io.ReadAll(resp.Body)
+	if err != nil {
+		return nil, fmt.Errorf("failed to read the OAuth2 token response: %w", err)
+	}
+	if resp.StatusCode > 299 {
+		return nil, fmt.Errorf("auth error: got http status: %d, response body: %s", resp.StatusCode, body)
+	}
+
+	var token AuthToken
+	if err := json.Unmarshal(body, &token); err != nil {
+		return nil, fmt.Errorf("failed to parse the OAuth2 token response: %w", err)
+	}
+	setTokenExpiry(cfg, &token)
+	return &token, nil
+}
+
+// setTokenExpiry derives the token expiry from expires_in. Without it the token
+// renewal ticker has nothing to schedule against and the client keeps using an
+// expired token until the API starts rejecting it.
+func setTokenExpiry(cfg *Configuration, token *AuthToken) {
+	if token.ExpiresIn.String() == "" {
+		return
+	}
+	seconds, err := strconv.ParseInt(token.ExpiresIn.String(), 10, 64)
+	if err != nil {
+		cfg.Logger.Printf("[WARN] could not parse expires_in %q: %v", token.ExpiresIn.String(), err)
+		return
+	}
+	token.Expiry = time.Now().Add(time.Duration(seconds) * time.Second)
+	cfg.Logger.Printf("[DEBUG] parsed expires_in=%d seconds, token expiry set to: %s", seconds, token.Expiry.Format(time.RFC3339))
+}
+
+// WithSigningConfig configures remote client assertion signing.
+func WithSigningConfig(signing remotesign.Config) ConfigSetter {
+	return func(c *Configuration) {
+		c.SigningConfig = signing
+	}
+}
+
+// WithSigningURL points the client at a remote signing endpoint, for example a
+// Vault Transit sign endpoint. Everything else is inferred or read from the
+// environment.
+func WithSigningURL(signingURL string) ConfigSetter {
+	return func(c *Configuration) {
+		c.SigningConfig.URL = signingURL
+	}
+}
+
+// WithSigner installs a caller-provided signer, which takes precedence over any
+// other signing configuration. Use it to sign through an SDK this module does
+// not depend on, such as a cloud KMS client.
+func WithSigner(signer remotesign.Signer) ConfigSetter {
+	return func(c *Configuration) {
+		c.Signer = signer
+	}
+}
