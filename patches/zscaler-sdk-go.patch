+func TestSignerHonoursContextCancellation(t *testing.T) {
+	vault := newVaultServer(t)
+	signer, err := New(Config{URL: vault.SignURL(), Token: "t"})
+	if err != nil {
+		t.Fatalf("New: %v", err)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if _, err := signer.Sign(ctx, []byte("header.payload")); err == nil {
+		t.Fatal("expected an error for a cancelled context")
+	}
+}
