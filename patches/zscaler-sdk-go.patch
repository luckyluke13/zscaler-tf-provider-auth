+package remotesign
+
+import (
+	"crypto"
+	"crypto/rand"
+	"crypto/rsa"
+	"testing"
+)
+
+// signPrehashedRS256 signs an already computed SHA-256 digest, which is what a
+// KMS "sign" operation does.
+func signPrehashedRS256(t *testing.T, digest []byte) []byte {
+	t.Helper()
+	signature, err := rsa.SignPKCS1v15(rand.Reader, signingKey(t), crypto.SHA256, digest)
+	if err != nil {
+		t.Fatalf("signing digest: %v", err)
+	}
+	return signature
+}
diff --git a/zscaler/remotesign/remotesign.go b/zscaler/remotesign/remotesign.go
new file mode 100644
index 0000000..e459929
--- /dev/null
+++ b/zscaler/remotesign/remotesign.go
@@ -0,0 +1,369 @@
+// Package remotesign builds OAuth2 JWT client assertions whose signature is
+// produced by a remote signing service instead of by a locally held private key.
+//
+// Zscaler OneAPI authenticates a client either with a client secret or with a
+// JWT client assertion signed by the private key of a registered public key.
+// The assertion is a short-lived, self-signed token, so the only thing that has
+// to happen locally is the assembly of the header and the claim set - the
+// signing operation itself can be delegated. Delegating it means the private
+// key never has to leave the KMS/HSM that generated it, which in turn means it
+// never has to be created as an exportable key.
+//
+// Two transports are supported out of the box:
+//
+//   - ModeVaultTransit: HashiCorp Vault / HCP Vault Dedicated Transit engine
+//     (POST {mount}/sign/{key}), including Vault token, JWT/OIDC workload
+//     identity and AppRole authentication against Vault itself.
+//   - ModeHTTP: a generic JSON HTTP endpoint, with a request body shape that
+//     also covers the Azure Key Vault / Managed HSM "sign" operation.
+//
+// Anything else can be plugged in programmatically by implementing Signer.
+package remotesign
+
+import (
+	"context"
+	"encoding/base64"
+	"encoding/hex"
+	"fmt"
+	"net/http"
+	"regexp"
+	"strings"
+	"time"
+
+	"github.com/golang-jwt/jwt/v5"
+)
+
+// Signing transports.
+const (
+	// ModeVaultTransit talks to a HashiCorp Vault Transit secrets engine.
+	ModeVaultTransit = "vault_transit"
+	// ModeHTTP talks to a generic JSON signing endpoint.
+	ModeHTTP = "http"
+)
+
+// Request body shapes for ModeHTTP.
+const (
+	// RequestFormatGeneric posts {"alg","key_id","signing_input","digest",...}.
+	RequestFormatGeneric = "generic"
+	// RequestFormatAzureKeyVault posts {"alg":"RS256","value":"<base64url digest>"},
+	// which is what Azure Key Vault and Managed HSM expect on
+	// POST {vault}/keys/{name}/{version}/sign?api-version=7.4.
+	RequestFormatAzureKeyVault = "azure_keyvault"
+)
+
+// Response shapes for ModeHTTP.
+const (
+	// ResponseFormatSignature means the endpoint returns a bare signature.
+	ResponseFormatSignature = "signature"
+	// ResponseFormatJWT means the endpoint returns a fully assembled assertion.
+	ResponseFormatJWT = "jwt"
+)
+
+// Authentication methods used to authenticate to the signing service itself.
+const (
+	// AuthMethodNone sends no credentials (mTLS, network policy, sidecar proxy).
+	AuthMethodNone = "none"
+	// AuthMethodToken sends a static token.
+	AuthMethodToken = "token"
+	// AuthMethodVaultJWT exchanges a workload identity JWT for a Vault token
+	// through the Vault JWT/OIDC (or Kubernetes) auth method.
+	AuthMethodVaultJWT = "vault_jwt"
+	// AuthMethodVaultAppRole logs in with a Vault AppRole role_id/secret_id pair.
+	AuthMethodVaultAppRole = "vault_approle"
+)
+
+// DefaultRequestTimeout bounds a single call to the signing service.
+const DefaultRequestTimeout = 30 * time.Second
+
+// Logger is the subset of the SDK logger used here.
+type Logger interface {
+	Printf(format string, v ...interface{})
+}
+
+type nopLogger struct{}
+
+func (nopLogger) Printf(string, ...interface{}) {}
+
+// Signer produces the signature of a JWT signing input ("<header>.<payload>").
+// Implementations must produce an RS256 (RSASSA-PKCS1-v1_5 over SHA-256)
+// signature, which is the only algorithm Zscaler OneAPI accepts today.
+type Signer interface {
+	Sign(ctx context.Context, signingInput []byte) (signature []byte, err error)
+}
+
+// AssertionSigner is an optional interface for services that mint the complete
+// assertion themselves. When a Signer also implements AssertionSigner,
+// BuildAssertion delegates to it and never assembles a JWT locally.
+type AssertionSigner interface {
+	SignAssertion(ctx context.Context, claims map[string]interface{}, keyID string) (string, error)
+}
+
+// Config describes how to reach the signing service. The zero value is invalid;
+// URL is always required unless a Signer is supplied programmatically.
+type Config struct {
+	// URL is the full signing endpoint, e.g.
+	// https://vault.example.com/v1/transit/sign/zscaler-oneapi
+	URL string
+	// Mode selects the transport. Empty means "infer from URL".
+	Mode string
+	// KeyID, when set, is emitted as the "kid" JOSE header of the assertion.
+	KeyID string
+
+	// Token is a static credential for the signing service: an X-Vault-Token in
+	// Vault mode, a bearer token in HTTP mode.
+	Token string
+	// AuthMethod selects how to authenticate to the signing service. Empty means
+	// "infer": token when Token is set, vault_jwt when a role and a JWT are set,
+	// vault_approle when RoleID/SecretID are set, otherwise none.
+	AuthMethod string
+	// AuthMount is the Vault auth mount path (default "jwt" for vault_jwt,
+	// "approle" for vault_approle).
+	AuthMount string
+	// Role is the Vault role to log in as.
+	Role string
+	// JWT is a workload identity token, used verbatim when set.
+	JWT string
+	// JWTTokenFile is a path to a workload identity token. It is re-read on
+	// every login so that projected/rotated tokens keep working.
+	JWTTokenFile string
+	// RoleID and SecretID are AppRole credentials.
+	RoleID   string
+	SecretID string
+
+	// Namespace is sent as X-Vault-Namespace. HCP Vault Dedicated clusters
+	// normally need "admin".
+	Namespace string
+	// KeyVersion pins a Transit key version (0 = latest).
+	KeyVersion int
+	// VaultAddress overrides the Vault base address used for login calls. When
+	// empty it is derived from URL by cutting at the "/v1/" path segment.
+	VaultAddress string
+
+	// RequestFormat and ResponseFormat apply to ModeHTTP only.
+	RequestFormat  string
+	ResponseFormat string
+	// SignatureField overrides response field lookup, e.g. "data.signature".
+	SignatureField string
+	// Headers are extra HTTP headers sent to the signing service.
+	Headers map[string]string
+
+	// RequestTimeout bounds a single signing call (default DefaultRequestTimeout).
+	RequestTimeout time.Duration
+	// HTTPClient overrides the HTTP client used to reach the signing service.
+	HTTPClient *http.Client
+	// Logger receives debug output.
+	Logger Logger
+}
+
+// IsConfigured reports whether anything was configured at all.
+func (c Config) IsConfigured() bool {
+	return strings.TrimSpace(c.URL) != ""
+}
+
+// vaultSignPath matches the Transit sign endpoint of a Vault URL.
+var vaultSignPath = regexp.MustCompile(`/v1/.+/sign/[^/]+`)
+
+// resolveMode returns the configured mode, or infers one from the URL.
+func (c Config) resolveMode() string {
+	if m := strings.ToLower(strings.TrimSpace(c.Mode)); m != "" {
+		return m
+	}
+	if vaultSignPath.MatchString(c.URL) {
+		return ModeVaultTransit
+	}
+	return ModeHTTP
+}
+
+// resolveAuthMethod returns the configured auth method, or infers one.
+func (c Config) resolveAuthMethod() string {
+	if m := strings.ToLower(strings.TrimSpace(c.AuthMethod)); m != "" {
+		return m
+	}
+	switch {
+	case c.Token != "":
+		return AuthMethodToken
+	case c.Role != "" && (c.JWT != "" || c.JWTTokenFile != ""):
+		return AuthMethodVaultJWT
+	case c.RoleID != "" && c.SecretID != "":
+		return AuthMethodVaultAppRole
+	default:
+		return AuthMethodNone
+	}
+}
+
+func (c Config) httpClient() *http.Client {
+	timeout := c.RequestTimeout
+	if timeout <= 0 {
+		timeout = DefaultRequestTimeout
+	}
+	if c.HTTPClient != nil {
+		client := *c.HTTPClient
+		if client.Timeout == 0 {
+			client.Timeout = timeout
+		}
+		return &client
+	}
+	return &http.Client{Timeout: timeout}
+}
+
+func (c Config) logger() Logger {
+	if c.Logger != nil {
+		return c.Logger
+	}
+	return nopLogger{}
+}
+
+// New builds a Signer from cfg.
+func New(cfg Config) (Signer, error) {
+	if !cfg.IsConfigured() {
+		return nil, fmt.Errorf("remotesign: no signing URL configured")
+	}
+	if !strings.HasPrefix(cfg.URL, "http://") && !strings.HasPrefix(cfg.URL, "https://") {
+		return nil, fmt.Errorf("remotesign: signing URL %q must be an absolute http(s) URL", cfg.URL)
+	}
+	switch mode := cfg.resolveMode(); mode {
+	case ModeVaultTransit:
+		return newVaultSigner(cfg)
+	case ModeHTTP:
+		return newHTTPSigner(cfg)
+	default:
+		return nil, fmt.Errorf("remotesign: unsupported signing mode %q (want %q or %q)", mode, ModeVaultTransit, ModeHTTP)
+	}
+}
+
+// AssertionParams describes the client assertion to mint.
+type AssertionParams struct {
+	// ClientID becomes both "iss" and "sub".
+	ClientID string
+	// Audience becomes "aud".
+	Audience string
+	// KeyID, when set, becomes the "kid" JOSE header.
+	KeyID string
+	// Lifetime defaults to 10 minutes, matching the local-key code path.
+	Lifetime time.Duration
+	// Now is overridable for tests.
+	Now func() time.Time
+}
+
+// BuildAssertion assembles a JWT bearer client assertion and has signer sign it.
+func BuildAssertion(ctx context.Context, signer Signer, p AssertionParams) (string, error) {
+	if signer == nil {
+		return "", fmt.Errorf("remotesign: no signer configured")
+	}
+	if p.ClientID == "" {
+		return "", fmt.Errorf("remotesign: client ID is required to build a client assertion")
+	}
+	if p.Audience == "" {
+		return "", fmt.Errorf("remotesign: audience is required to build a client assertion")
+	}
+	lifetime := p.Lifetime
+	if lifetime <= 0 {
+		lifetime = 10 * time.Minute
+	}
+	now := time.Now
+	if p.Now != nil {
+		now = p.Now
+	}
+
+	// Keep the claim set identical to the local private key code path so that
+	// remote signing is a drop-in replacement as far as Zscaler is concerned.
+	claims := map[string]interface{}{
+		"iss": p.ClientID,
+		"sub": p.ClientID,
+		"aud": p.Audience,
+		"exp": now().Add(lifetime).Unix(),
+	}
+
+	if as, ok := signer.(AssertionSigner); ok {
+		assertion, err := as.SignAssertion(ctx, claims, p.KeyID)
+		if err != nil {
+			return "", err
+		}
+		if err := validateAssertionShape(assertion); err != nil {
+			return "", err
+		}
+		return assertion, nil
+	}
+
+	token := jwt.NewWithClaims(jwt.SigningMethodRS256, jwt.MapClaims(claims))
+	if p.KeyID != "" {
+		token.Header["kid"] = p.KeyID
+	}
+	signingInput, err := token.SigningString()
+	if err != nil {
+		return "", fmt.Errorf("remotesign: building JWT signing input: %w", err)
+	}
+
+	signature, err := signer.Sign(ctx, []byte(signingInput))
+	if err != nil {
+		return "", err
+	}
+	if len(signature) == 0 {
+		return "", fmt.Errorf("remotesign: signing service returned an empty signature")
+	}
+
+	return signingInput + "." + base64.RawURLEncoding.EncodeToString(signature), nil
+}
+
+func validateAssertionShape(assertion string) error {
+	if strings.Count(assertion, ".") != 2 || strings.HasSuffix(assertion, ".") {
+		return fmt.Errorf("remotesign: signing service did not return a signed JWT")
+	}
+	return nil
+}
+
+var vaultSignaturePrefix = regexp.MustCompile(`^vault:v[0-9]+:`)
+
+// decodeSignature turns whatever encoding the signing service used into raw
+// signature bytes. Vault Transit returns "vault:v1:<std base64>", Azure Key
+// Vault returns unpadded base64url, and some gateways return hex.
+func decodeSignature(value string) ([]byte, error) {
+	s := strings.TrimSpace(value)
+	s = strings.Trim(s, `"`)
+	s = vaultSignaturePrefix.ReplaceAllString(s, "")
+	if s == "" {
+		return nil, fmt.Errorf("remotesign: signing service returned an empty signature")
+	}
+
+	// Hex is checked first for strings that can only be hex: the hex alphabet is
+	// a subset of the base64 one, so an unlucky base64 attempt would otherwise
+	// "succeed" and produce garbage.
+	if isHex(s) {
+		if decoded, err := hex.DecodeString(s); err == nil && len(decoded) > 0 {
+			return decoded, nil
+		}
+	}
+
+	encodings := []*base64.Encoding{base64.StdEncoding, base64.RawStdEncoding, base64.URLEncoding, base64.RawURLEncoding}
+	if strings.ContainsAny(s, "-_") {
+		encodings = []*base64.Encoding{base64.URLEncoding, base64.RawURLEncoding}
+	}
+	for _, enc := range encodings {
+		if decoded, err := enc.DecodeString(s); err == nil && len(decoded) > 0 {
+			return decoded, nil
+		}
+	}
+	return nil, fmt.Errorf("remotesign: could not decode signature %q as base64 or hex", truncate(s, 32))
+}
+
+// isHex reports whether s can only be a hex encoded byte string.
+func isHex(s string) bool {
+	if s == "" || len(s)%2 != 0 {
+		return false
+	}
+	for _, r := range s {
+		switch {
+		case r >= '0' && r <= '9', r >= 'a' && r <= 'f', r >= 'A' && r <= 'F':
+		default:
+			return false
+		}
+	}
+	return true
+}
+
+func truncate(s string, n int) string {
+	if len(s) <= n {
+		return s
+	}
+	return s[:n] + "..."
+}
diff --git a/zscaler/remotesign/testsupport_test.go b/zscaler/remotesign/testsupport_test.go
new file mode 100644
index 0000000..2ba8f46
--- /dev/null
+++ b/zscaler/remotesign/testsupport_test.go
@@ -0,0 +1,173 @@
+package remotesign
+
+import (
+	"crypto"
+	"crypto/rand"
+	"crypto/rsa"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/golang-jwt/jwt/v5"
+)
+
+var (
+	testKeyOnce sync.Once
+	testKey     *rsa.PrivateKey
+)
+
+// signingKey returns a process-wide RSA key. Generating a 2048 bit key is slow
+// enough that it is worth doing exactly once.
+func signingKey(t *testing.T) *rsa.PrivateKey {
+	t.Helper()
+	testKeyOnce.Do(func() {
+		key, err := rsa.GenerateKey(rand.Reader, 2048)
+		if err != nil {
+			panic(err)
+		}
+		testKey = key
+	})
+	return testKey
+}
+
+// signRS256 signs data the way a KMS would.
+func signRS256(t *testing.T, data []byte) []byte {
+	t.Helper()
+	digest := sha256.Sum256(data)
+	signature, err := rsa.SignPKCS1v15(rand.Reader, signingKey(t), crypto.SHA256, digest[:])
+	if err != nil {
+		t.Fatalf("signing test data: %v", err)
+	}
+	return signature
+}
+
+// vaultServer is a minimal stand-in for a Vault Transit engine.
+type vaultServer struct {
+	*httptest.Server
+
+	mu           sync.Mutex
+	SignRequests []map[string]interface{}
+	SignHeaders  []http.Header
+	Logins       int
+	LoginBodies  []map[string]string
+
+	// IssuedToken is handed out by the login endpoints.
+	IssuedToken string
+	// LeaseDuration is reported by the login endpoints.
+	LeaseDuration int
+	// RequireToken, when set, is the only token the sign endpoint accepts.
+	RequireToken string
+	// FailSignOnce makes the first sign call answer 403.
+	FailSignOnce bool
+}
+
+func newVaultServer(t *testing.T) *vaultServer {
+	t.Helper()
+	server := &vaultServer{IssuedToken: "hvs.issued-token", LeaseDuration: 3600}
+
+	mux := http.NewServeMux()
+	mux.HandleFunc("/v1/auth/", func(w http.ResponseWriter, r *http.Request) {
+		if !strings.HasSuffix(r.URL.Path, "/login") {
+			http.NotFound(w, r)
+			return
+		}
+		var body map[string]string
+		_ = json.NewDecoder(r.Body).Decode(&body)
+
+		server.mu.Lock()
+		server.Logins++
+		server.LoginBodies = append(server.LoginBodies, body)
+		token := server.IssuedToken
+		lease := server.LeaseDuration
+		server.mu.Unlock()
+
+		writeJSON(w, http.StatusOK, map[string]interface{}{
+			"auth": map[string]interface{}{
+				"client_token":   token,
+				"lease_duration": lease,
+			},
+		})
+	})
+	mux.HandleFunc("/v1/transit/sign/", func(w http.ResponseWriter, r *http.Request) {
+		var body map[string]interface{}
+		if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+			writeJSON(w, http.StatusBadRequest, map[string]interface{}{"errors": []string{"malformed body"}})
+			return
+		}
+
+		server.mu.Lock()
+		server.SignRequests = append(server.SignRequests, body)
+		server.SignHeaders = append(server.SignHeaders, r.Header.Clone())
+		failOnce := server.FailSignOnce
+		if failOnce {
+			server.FailSignOnce = false
+		}
+		required := server.RequireToken
+		server.mu.Unlock()
+
+		if failOnce {
+			writeJSON(w, http.StatusForbidden, map[string]interface{}{"errors": []string{"permission denied"}})
+			return
+		}
+		if required != "" && r.Header.Get("X-Vault-Token") != required {
+			writeJSON(w, http.StatusForbidden, map[string]interface{}{"errors": []string{"permission denied"}})
+			return
+		}
+
+		input, err := base64.StdEncoding.DecodeString(asString(body["input"]))
+		if err != nil {
+			writeJSON(w, http.StatusBadRequest, map[string]interface{}{"errors": []string{"input is not base64"}})
+			return
+		}
+		writeJSON(w, http.StatusOK, map[string]interface{}{
+			"data": map[string]interface{}{
+				"signature": "vault:v1:" + base64.StdEncoding.EncodeToString(signRS256(t, input)),
+			},
+		})
+	})
+
+	server.Server = httptest.NewServer(mux)
+	t.Cleanup(server.Close)
+	return server
+}
+
+func (v *vaultServer) SignURL() string { return v.URL + "/v1/transit/sign/zscaler-oneapi" }
+
+func (v *vaultServer) snapshot() ([]map[string]interface{}, []http.Header, int) {
+	v.mu.Lock()
+	defer v.mu.Unlock()
+	return v.SignRequests, v.SignHeaders, v.Logins
+}
+
+func writeJSON(w http.ResponseWriter, status int, body interface{}) {
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(status)
+	_ = json.NewEncoder(w).Encode(body)
+}
+
+func asString(value interface{}) string {
+	s, _ := value.(string)
+	return s
+}
+
+// verifyAssertion checks that assertion is a well formed RS256 JWT signed by the
+// test key and returns its claims.
+func verifyAssertion(t *testing.T, assertion string) jwt.MapClaims {
+	t.Helper()
+	claims := jwt.MapClaims{}
+	parsed, err := jwt.ParseWithClaims(assertion, claims, func(token *jwt.Token) (interface{}, error) {
+		return &signingKey(t).PublicKey, nil
+	}, jwt.WithValidMethods([]string{"RS256"}))
+	if err != nil {
+		t.Fatalf("assertion did not verify: %v", err)
+	}
+	if !parsed.Valid {
+		t.Fatal("assertion is not valid")
+	}
+	return claims
+}
diff --git a/zscaler/remotesign/vault.go b/zscaler/remotesign/vault.go
new file mode 100644
index 0000000..f54a667
--- /dev/null
+++ b/zscaler/remotesign/vault.go
@@ -0,0 +1,365 @@
+package remotesign
+
+import (
+	"bytes"
+	"context"
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"strings"
+	"sync"
+	"time"
+)
+
+const (
+	defaultJWTAuthMount     = "jwt"
+	defaultAppRoleAuthMount = "approle"
+
+	// vaultTokenRenewSkew is how long before its lease a cached Vault token is
+	// considered stale.
+	vaultTokenRenewSkew = 60 * time.Second
+)
+
+// vaultSigner signs through a Vault Transit secrets engine.
+type vaultSigner struct {
+	signURL    string
+	namespace  string
+	keyVersion int
+	headers    map[string]string
+	auth       *vaultAuth
+	client     *http.Client
+	logger     Logger
+}
+
+func newVaultSigner(cfg Config) (Signer, error) {
+	address, err := vaultAddress(cfg)
+	if err != nil {
+		return nil, err
+	}
+	auth, err := newVaultAuth(cfg, address)
+	if err != nil {
+		return nil, err
+	}
+	return &vaultSigner{
+		signURL:    cfg.URL,
+		namespace:  cfg.Namespace,
+		keyVersion: cfg.KeyVersion,
+		headers:    cfg.Headers,
+		auth:       auth,
+		client:     cfg.httpClient(),
+		logger:     cfg.logger(),
+	}, nil
+}
+
+// vaultAddress resolves the Vault base address used for login calls. It is
+// either configured explicitly or derived from the signing URL by cutting at
+// the "/v1/" API path segment.
+func vaultAddress(cfg Config) (string, error) {
+	if addr := strings.TrimRight(strings.TrimSpace(cfg.VaultAddress), "/"); addr != "" {
+		return addr, nil
+	}
+	if idx := strings.Index(cfg.URL, "/v1/"); idx > 0 {
+		return cfg.URL[:idx], nil
+	}
+	// Only login flows need the base address; a static token does not.
+	if cfg.resolveAuthMethod() == AuthMethodToken || cfg.resolveAuthMethod() == AuthMethodNone {
+		return "", nil
+	}
+	return "", fmt.Errorf("remotesign: cannot derive the Vault address from signing URL %q; set the Vault address explicitly", cfg.URL)
+}
+
+type vaultSignRequest struct {
+	Input              string `json:"input"`
+	HashAlgorithm      string `json:"hash_algorithm"`
+	SignatureAlgorithm string `json:"signature_algorithm"`
+	Prehashed          bool   `json:"prehashed"`
+	KeyVersion         int    `json:"key_version,omitempty"`
+}
+
+type vaultSignResponse struct {
+	Data struct {
+		Signature string `json:"signature"`
+	} `json:"data"`
+	Errors []string `json:"errors"`
+}
+
+func (v *vaultSigner) Sign(ctx context.Context, signingInput []byte) ([]byte, error) {
+	payload, err := json.Marshal(vaultSignRequest{
+		// Vault hashes the input itself: the assertion signing input is sent
+		// verbatim, never the private key and never a pre-computed digest.
+		Input:              base64.StdEncoding.EncodeToString(signingInput),
+		HashAlgorithm:      "sha2-256",
+		SignatureAlgorithm: "pkcs1v15",
+		Prehashed:          false,
+		KeyVersion:         v.keyVersion,
+	})
+	if err != nil {
+		return nil, fmt.Errorf("remotesign: encoding Vault sign request: %w", err)
+	}
+
+	signature, status, err := v.doSign(ctx, payload, false)
+	// A cached Vault token can expire or be revoked between two assertions;
+	// re-authenticate once and retry before giving up.
+	if err != nil && (status == http.StatusForbidden || status == http.StatusUnauthorized) {
+		v.logger.Printf("[DEBUG] remotesign: Vault rejected the cached token (HTTP %d), re-authenticating", status)
+		v.auth.invalidate()
+		signature, _, err = v.doSign(ctx, payload, true)
+	}
+	return signature, err
+}
+
+func (v *vaultSigner) doSign(ctx context.Context, payload []byte, forceLogin bool) ([]byte, int, error) {
+	token, err := v.auth.token(ctx, forceLogin)
+	if err != nil {
+		return nil, 0, err
+	}
+
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, v.signURL, bytes.NewReader(payload))
+	if err != nil {
+		return nil, 0, fmt.Errorf("remotesign: building Vault sign request: %w", err)
+	}
+	req.Header.Set("Content-Type", "application/json")
+	for name, value := range v.headers {
+		req.Header.Set(name, value)
+	}
+	if token != "" {
+		req.Header.Set("X-Vault-Token", token)
+	}
+	if v.namespace != "" {
+		req.Header.Set("X-Vault-Namespace", v.namespace)
+	}
+
+	resp, err := v.client.Do(req)
+	if err != nil {
+		return nil, 0, fmt.Errorf("remotesign: calling Vault Transit sign endpoint: %w", err)
+	}
+	defer resp.Body.Close()
+
+	body, err := io.ReadAll(resp.Body)
+	if err != nil {
+		return nil, resp.StatusCode, fmt.Errorf("remotesign: reading Vault response: %w", err)
+	}
+
+	var parsed vaultSignResponse
+	// Vault always answers JSON, but a proxy in front of it might not.
+	_ = json.Unmarshal(body, &parsed)
+
+	if resp.StatusCode > 299 {
+		return nil, resp.StatusCode, fmt.Errorf("remotesign: Vault Transit sign failed with HTTP %d: %s", resp.StatusCode, vaultErrorMessage(parsed.Errors, body))
+	}
+	if parsed.Data.Signature == "" {
+		return nil, resp.StatusCode, fmt.Errorf("remotesign: Vault Transit response contained no signature: %s", truncate(string(body), 256))
+	}
+
+	signature, err := decodeSignature(parsed.Data.Signature)
+	if err != nil {
+		return nil, resp.StatusCode, err
+	}
+	return signature, resp.StatusCode, nil
+}
+
+func vaultErrorMessage(errors []string, body []byte) string {
+	if len(errors) > 0 {
+		return strings.Join(errors, "; ")
+	}
+	return truncate(strings.TrimSpace(string(body)), 256)
+}
+
+// vaultAuth obtains and caches the Vault token used for signing.
+type vaultAuth struct {
+	method    string
+	address   string
+	mount     string
+	role      string
+	jwt       string
+	jwtFile   string
+	roleID    string
+	secretID  string
+	namespace string
+	client    *http.Client
+	logger    Logger
+
+	mu     sync.Mutex
+	token_ string
+	expiry time.Time
+}
+
+func newVaultAuth(cfg Config, address string) (*vaultAuth, error) {
+	method := cfg.resolveAuthMethod()
+	auth := &vaultAuth{
+		method:    method,
+		address:   address,
+		mount:     strings.Trim(strings.TrimSpace(cfg.AuthMount), "/"),
+		role:      cfg.Role,
+		jwt:       cfg.JWT,
+		jwtFile:   cfg.JWTTokenFile,
+		roleID:    cfg.RoleID,
+		secretID:  cfg.SecretID,
+		namespace: cfg.Namespace,
+		client:    cfg.httpClient(),
+		logger:    cfg.logger(),
+	}
+
+	switch method {
+	case AuthMethodNone:
+	case AuthMethodToken:
+		if cfg.Token == "" {
+			return nil, fmt.Errorf("remotesign: signing auth method %q requires a token", AuthMethodToken)
+		}
+		auth.token_ = cfg.Token
+	case AuthMethodVaultJWT:
+		if auth.mount == "" {
+			auth.mount = defaultJWTAuthMount
+		}
+		if auth.role == "" {
+			return nil, fmt.Errorf("remotesign: signing auth method %q requires a Vault role", AuthMethodVaultJWT)
+		}
+		if auth.jwt == "" && auth.jwtFile == "" {
+			return nil, fmt.Errorf("remotesign: signing auth method %q requires a workload identity token or token file", AuthMethodVaultJWT)
+		}
+		if auth.address == "" {
+			return nil, fmt.Errorf("remotesign: signing auth method %q requires a Vault address", AuthMethodVaultJWT)
+		}
+	case AuthMethodVaultAppRole:
+		if auth.mount == "" {
+			auth.mount = defaultAppRoleAuthMount
+		}
+		if auth.roleID == "" || auth.secretID == "" {
+			return nil, fmt.Errorf("remotesign: signing auth method %q requires a role ID and a secret ID", AuthMethodVaultAppRole)
+		}
+		if auth.address == "" {
+			return nil, fmt.Errorf("remotesign: signing auth method %q requires a Vault address", AuthMethodVaultAppRole)
+		}
+	default:
+		return nil, fmt.Errorf("remotesign: unsupported signing auth method %q", method)
+	}
+	return auth, nil
+}
+
+// token returns a usable Vault token, logging in when needed.
+func (a *vaultAuth) token(ctx context.Context, forceLogin bool) (string, error) {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+
+	switch a.method {
+	case AuthMethodNone:
+		return "", nil
+	case AuthMethodToken:
+		// A static token is not refreshable: hand it back as configured.
+		return a.token_, nil
+	}
+
+	if !forceLogin && a.token_ != "" && (a.expiry.IsZero() || time.Now().Before(a.expiry)) {
+		return a.token_, nil
+	}
+	if err := a.login(ctx); err != nil {
+		return "", err
+	}
+	return a.token_, nil
+}
+
+// invalidate drops a cached login so the next signing call authenticates again.
+func (a *vaultAuth) invalidate() {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if a.method == AuthMethodToken || a.method == AuthMethodNone {
+		return
+	}
+	a.token_ = ""
+	a.expiry = time.Time{}
+}
+
+type vaultLoginResponse struct {
+	Auth struct {
+		ClientToken   string `json:"client_token"`
+		LeaseDuration int    `json:"lease_duration"`
+	} `json:"auth"`
+	Errors []string `json:"errors"`
+}
+
+func (a *vaultAuth) login(ctx context.Context) error {
+	var payload map[string]string
+	switch a.method {
+	case AuthMethodVaultJWT:
+		assertion, err := a.workloadIdentityToken()
+		if err != nil {
+			return err
+		}
+		payload = map[string]string{"role": a.role, "jwt": assertion}
+	case AuthMethodVaultAppRole:
+		payload = map[string]string{"role_id": a.roleID, "secret_id": a.secretID}
+	default:
+		return fmt.Errorf("remotesign: cannot log in to Vault with auth method %q", a.method)
+	}
+
+	body, err := json.Marshal(payload)
+	if err != nil {
+		return fmt.Errorf("remotesign: encoding Vault login request: %w", err)
+	}
+
+	loginURL := fmt.Sprintf("%s/v1/auth/%s/login", strings.TrimRight(a.address, "/"), a.mount)
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, loginURL, bytes.NewReader(body))
+	if err != nil {
+		return fmt.Errorf("remotesign: building Vault login request: %w", err)
+	}
+	req.Header.Set("Content-Type", "application/json")
+	if a.namespace != "" {
+		req.Header.Set("X-Vault-Namespace", a.namespace)
+	}
+
+	resp, err := a.client.Do(req)
+	if err != nil {
+		return fmt.Errorf("remotesign: logging in to Vault at %s: %w", loginURL, err)
+	}
+	defer resp.Body.Close()
+
+	respBody, err := io.ReadAll(resp.Body)
+	if err != nil {
+		return fmt.Errorf("remotesign: reading Vault login response: %w", err)
+	}
+
+	var parsed vaultLoginResponse
+	_ = json.Unmarshal(respBody, &parsed)
+
+	if resp.StatusCode > 299 {
+		return fmt.Errorf("remotesign: Vault login failed with HTTP %d: %s", resp.StatusCode, vaultErrorMessage(parsed.Errors, respBody))
+	}
+	if parsed.Auth.ClientToken == "" {
+		return fmt.Errorf("remotesign: Vault login response contained no client token: %s", truncate(strings.TrimSpace(string(respBody)), 256))
+	}
+
+	a.token_ = parsed.Auth.ClientToken
+	// A response without a lease (a root token, for instance) is treated as
+	// non-expiring; a lease shorter than the renewal skew is treated as
+	// single-use, so the next signature logs in again.
+	switch lease := time.Duration(parsed.Auth.LeaseDuration) * time.Second; {
+	case lease > vaultTokenRenewSkew:
+		a.expiry = time.Now().Add(lease - vaultTokenRenewSkew)
+	case lease > 0:
+		a.expiry = time.Now()
+	default:
+		a.expiry = time.Time{}
+	}
+	a.logger.Printf("[DEBUG] remotesign: authenticated to Vault via %s/%s", a.method, a.mount)
+	return nil
+}
+
+// workloadIdentityToken returns the JWT presented to Vault. The file is read on
+// every login because projected service account tokens are rotated in place.
+func (a *vaultAuth) workloadIdentityToken() (string, error) {
+	if a.jwtFile == "" {
+		return a.jwt, nil
+	}
+	content, err := os.ReadFile(a.jwtFile)
+	if err != nil {
+		return "", fmt.Errorf("remotesign: reading workload identity token %s: %w", a.jwtFile, err)
+	}
+	token := strings.TrimSpace(string(content))
+	if token == "" {
+		return "", fmt.Errorf("remotesign: workload identity token file %s is empty", a.jwtFile)
+	}
+	return token, nil
+}
diff --git a/zscaler/remotesign/vault_test.go b/zscaler/remotesign/vault_test.go
