+func TestCustomHeadersReachTheSigningService(t *testing.T) {
+	vault := newVaultServer(t)
+	signer, err := New(Config{
+		URL:     vault.SignURL(),
+		Token:   "t",
+		Headers: map[string]string{"X-Request-Source": "terraform"},
+	})
+	if err != nil {
+		t.Fatalf("New: %v", err)
+	}
+	if _, err := signer.Sign(context.Background(), []byte("header.payload")); err != nil {
+		t.Fatalf("Sign: %v", err)
+	}
+	_, headers, _ := vault.snapshot()
+	if got := headers[0].Get("X-Request-Source"); got != "terraform" {
+		t.Errorf("X-Request-Source = %q, want terraform", got)
+	}
+}
