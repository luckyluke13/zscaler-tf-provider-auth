+func TestModeAndAuthMethodInference(t *testing.T) {
+	if got := (Config{URL: "https://v.example.com/v1/transit/sign/key"}).resolveMode(); got != ModeVaultTransit {
+		t.Errorf("mode = %q, want %q for a Transit sign URL", got, ModeVaultTransit)
+	}
+	if got := (Config{URL: "https://kms.example.com/sign"}).resolveMode(); got != ModeHTTP {
+		t.Errorf("mode = %q, want %q for a generic URL", got, ModeHTTP)
+	}
+	if got := (Config{URL: "https://v/v1/x/sign/k", Mode: ModeHTTP}).resolveMode(); got != ModeHTTP {
+		t.Error("an explicit mode must win over inference")
+	}
+
+	cases := []struct {
+		cfg  Config
+		want string
+	}{
+		{Config{Token: "t"}, AuthMethodToken},
+		{Config{Role: "r", JWTTokenFile: "/f"}, AuthMethodVaultJWT},
+		{Config{RoleID: "r", SecretID: "s"}, AuthMethodVaultAppRole},
+		{Config{}, AuthMethodNone},
+		{Config{Token: "t", AuthMethod: AuthMethodNone}, AuthMethodNone},
+	}
+	for _, tc := range cases {
+		if got := tc.cfg.resolveAuthMethod(); got != tc.want {
+			t.Errorf("resolveAuthMethod(%+v) = %q, want %q", tc.cfg, got, tc.want)
+		}
+	}
+}
