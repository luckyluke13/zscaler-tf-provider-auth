@@ -0,0 +1,362 @@
+package remotesign
+
+import (
+	"context"
+	"encoding/base64"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestVaultTransitSignProducesVerifiableAssertion(t *testing.T) {
+	vault := newVaultServer(t)
+	vault.RequireToken = "hvs.static-token"
+
+	signer, err := New(Config{
+		URL:       vault.SignURL(),
+		Token:     "hvs.static-token",
+		Namespace: "admin",
+		KeyID:     "zscaler-key-1",
+	})
+	if err != nil {
+		t.Fatalf("New: %v", err)
+	}
+
+	assertion, err := BuildAssertion(context.Background(), signer, AssertionParams{
+		ClientID: "client-123",
+		Audience: "https://api.zscaler.com",
+		KeyID:    "zscaler-key-1",
+	})
+	if err != nil {
+		t.Fatalf("BuildAssertion: %v", err)
+	}
+
+	claims := verifyAssertion(t, assertion)
+	for name, want := range map[string]string{"iss": "client-123", "sub": "client-123", "aud": "https://api.zscaler.com"} {
+		if got, _ := claims[name].(string); got != want {
+			t.Errorf("claim %s = %q, want %q", name, got, want)
+		}
+	}
+	if _, ok := claims["exp"]; !ok {
+		t.Error("assertion has no exp claim")
+	}
+
+	requests, headers, logins := vault.snapshot()
+	if len(requests) != 1 {
+		t.Fatalf("got %d sign requests, want 1", len(requests))
+	}
+	if logins != 0 {
+		t.Errorf("got %d Vault logins for a static token, want 0", logins)
+	}
+
+	request := requests[0]
+	if got := asString(request["hash_algorithm"]); got != "sha2-256" {
+		t.Errorf("hash_algorithm = %q, want sha2-256", got)
+	}
+	if got := asString(request["signature_algorithm"]); got != "pkcs1v15" {
+		t.Errorf("signature_algorithm = %q, want pkcs1v15", got)
+	}
+	if prehashed, _ := request["prehashed"].(bool); prehashed {
+		t.Error("prehashed = true, want false: Vault must hash the signing input itself")
+	}
+	if _, ok := request["key_version"]; ok {
+		t.Error("key_version must be omitted when it is not pinned")
+	}
+
+	// The signing service must receive the signing input, never key material.
+	input, err := base64.StdEncoding.DecodeString(asString(request["input"]))
+	if err != nil {
+		t.Fatalf("input is not standard base64: %v", err)
+	}
+	if want := assertion[:strings.LastIndex(assertion, ".")]; string(input) != want {
+		t.Errorf("signed input = %q, want %q", input, want)
+	}
+
+	if got := headers[0].Get("X-Vault-Token"); got != "hvs.static-token" {
+		t.Errorf("X-Vault-Token = %q, want the configured token", got)
+	}
+	if got := headers[0].Get("X-Vault-Namespace"); got != "admin" {
+		t.Errorf("X-Vault-Namespace = %q, want admin", got)
+	}
+}
+
+func TestVaultTransitPinsKeyVersion(t *testing.T) {
+	vault := newVaultServer(t)
+
+	signer, err := New(Config{URL: vault.SignURL(), Token: "t", KeyVersion: 3})
+	if err != nil {
+		t.Fatalf("New: %v", err)
+	}
+	if _, err := signer.Sign(context.Background(), []byte("header.payload")); err != nil {
+		t.Fatalf("Sign: %v", err)
+	}
+
+	requests, _, _ := vault.snapshot()
+	if version, _ := requests[0]["key_version"].(float64); version != 3 {
+		t.Errorf("key_version = %v, want 3", requests[0]["key_version"])
+	}
+}
+
+func TestVaultWorkloadIdentityLoginAndTokenReuse(t *testing.T) {
+	vault := newVaultServer(t)
+	vault.RequireToken = "hvs.issued-token"
+
+	tokenFile := filepath.Join(t.TempDir(), "token")
+	if err := os.WriteFile(tokenFile, []byte("workload-identity-jwt\n"), 0o600); err != nil {
+		t.Fatalf("writing token file: %v", err)
+	}
+
+	signer, err := New(Config{
+		URL:          vault.SignURL(),
+		Role:         "zscaler-terraform",
+		JWTTokenFile: tokenFile,
+		AuthMount:    "jwt",
+	})
+	if err != nil {
+		t.Fatalf("New: %v", err)
+	}
+
+	for i := 0; i < 2; i++ {
+		if _, err := signer.Sign(context.Background(), []byte("header.payload")); err != nil {
+			t.Fatalf("Sign %d: %v", i, err)
+		}
+	}
+
+	_, _, logins := vault.snapshot()
+	if logins != 1 {
+		t.Errorf("got %d logins for 2 signatures, want 1 (the Vault token must be cached)", logins)
+	}
+	if got := vault.LoginBodies[0]["role"]; got != "zscaler-terraform" {
+		t.Errorf("login role = %q, want zscaler-terraform", got)
+	}
+	// The trailing newline of a projected token file must not be sent.
+	if got := vault.LoginBodies[0]["jwt"]; got != "workload-identity-jwt" {
+		t.Errorf("login jwt = %q, want the trimmed file contents", got)
+	}
+}
+
+func TestVaultReauthenticatesAfterPermissionDenied(t *testing.T) {
+	vault := newVaultServer(t)
+	vault.FailSignOnce = true
+
+	signer, err := New(Config{
+		URL:  vault.SignURL(),
+		Role: "zscaler-terraform",
+		JWT:  "workload-identity-jwt",
+	})
+	if err != nil {
+		t.Fatalf("New: %v", err)
+	}
+
+	if _, err := signer.Sign(context.Background(), []byte("header.payload")); err != nil {
+		t.Fatalf("Sign: %v", err)
+	}
+	if _, _, logins := vault.snapshot(); logins != 2 {
+		t.Errorf("got %d logins, want 2 (initial login plus one retry after 403)", logins)
+	}
+}
+
+func TestVaultAppRoleLogin(t *testing.T) {
+	vault := newVaultServer(t)
+	vault.RequireToken = "hvs.issued-token"
+
+	signer, err := New(Config{URL: vault.SignURL(), RoleID: "role-id", SecretID: "secret-id"})
+	if err != nil {
+		t.Fatalf("New: %v", err)
+	}
+	if _, err := signer.Sign(context.Background(), []byte("header.payload")); err != nil {
+		t.Fatalf("Sign: %v", err)
+	}
+	if got := vault.LoginBodies[0]["role_id"]; got != "role-id" {
+		t.Errorf("login role_id = %q, want role-id", got)
+	}
+}
+
+func TestVaultShortLeaseIsNotCached(t *testing.T) {
+	vault := newVaultServer(t)
+	vault.LeaseDuration = 5 // shorter than the renewal skew
+
+	signer, err := New(Config{URL: vault.SignURL(), Role: "r", JWT: "j"})
+	if err != nil {
+		t.Fatalf("New: %v", err)
+	}
+	for i := 0; i < 2; i++ {
+		if _, err := signer.Sign(context.Background(), []byte("header.payload")); err != nil {
+			t.Fatalf("Sign %d: %v", i, err)
+		}
+	}
+	if _, _, logins := vault.snapshot(); logins != 2 {
+		t.Errorf("got %d logins, want 2: a lease shorter than the skew must not be cached", logins)
+	}
+}
+
+func TestVaultSurfacesServerErrors(t *testing.T) {
+	vault := newVaultServer(t)
+	vault.RequireToken = "hvs.expected"
+
+	signer, err := New(Config{URL: vault.SignURL(), Token: "hvs.wrong"})
+	if err != nil {
+		t.Fatalf("New: %v", err)
+	}
+	_, err = signer.Sign(context.Background(), []byte("header.payload"))
+	if err == nil {
+		t.Fatal("expected an error for a rejected token")
+	}
+	if !strings.Contains(err.Error(), "permission denied") {
+		t.Errorf("error %q does not surface the Vault message", err)
+	}
+}
+
+func TestVaultAddressDerivation(t *testing.T) {
+	cases := []struct {
+		name string
+		cfg  Config
+		want string
+	}{
+		{
+			name: "derived from the sign URL",
+			cfg:  Config{URL: "https://vault.example.com:8200/v1/transit/sign/key", Role: "r", JWT: "j"},
+			want: "https://vault.example.com:8200",
+		},
+		{
+			name: "explicit override wins",
+			cfg:  Config{URL: "https://gateway.example.com/sign", VaultAddress: "https://vault.example.com/", Role: "r", JWT: "j"},
+			want: "https://vault.example.com",
+		},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := vaultAddress(tc.cfg)
+			if err != nil {
+				t.Fatalf("vaultAddress: %v", err)
+			}
+			if got != tc.want {
+				t.Errorf("vaultAddress = %q, want %q", got, tc.want)
+			}
+		})
+	}
+}
+
+func TestVaultConfigValidation(t *testing.T) {
+	cases := []struct {
+		name    string
+		cfg     Config
+		wantErr string
+	}{
+		{
+			name:    "jwt auth without a role",
+			cfg:     Config{URL: "https://v.example.com/v1/transit/sign/k", AuthMethod: AuthMethodVaultJWT, JWT: "j"},
+			wantErr: "requires a Vault role",
+		},
+		{
+			name:    "jwt auth without a token",
+			cfg:     Config{URL: "https://v.example.com/v1/transit/sign/k", AuthMethod: AuthMethodVaultJWT, Role: "r"},
+			wantErr: "workload identity token",
+		},
+		{
+			name:    "approle without a secret id",
+			cfg:     Config{URL: "https://v.example.com/v1/transit/sign/k", AuthMethod: AuthMethodVaultAppRole, RoleID: "r"},
+			wantErr: "requires a role ID and a secret ID",
+		},
+		{
+			name:    "token auth without a token",
+			cfg:     Config{URL: "https://v.example.com/v1/transit/sign/k", AuthMethod: AuthMethodToken},
+			wantErr: "requires a token",
+		},
+		{
+			name:    "unknown auth method",
+			cfg:     Config{URL: "https://v.example.com/v1/transit/sign/k", AuthMethod: "kerberos"},
+			wantErr: "unsupported signing auth method",
+		},
+		{
+			name:    "login without a derivable address",
+			cfg:     Config{URL: "https://gateway.example.com/sign", Mode: ModeVaultTransit, AuthMethod: AuthMethodVaultJWT, Role: "r", JWT: "j"},
+			wantErr: "cannot derive the Vault address",
+		},
+		{
+			name:    "relative URL",
+			cfg:     Config{URL: "vault.example.com/v1/transit/sign/k"},
+			wantErr: "absolute http(s) URL",
+		},
+		{
+			name:    "unknown mode",
+			cfg:     Config{URL: "https://v.example.com/sign", Mode: "grpc"},
+			wantErr: "unsupported signing mode",
+		},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			_, err := New(tc.cfg)
+			if err == nil {
+				t.Fatal("expected a configuration error")
+			}
+			if !strings.Contains(err.Error(), tc.wantErr) {
+				t.Errorf("error %q does not contain %q", err, tc.wantErr)
+			}
+		})
+	}
+}
