+func TestSigningConfigFromResourceData(t *testing.T) {
+	data := signingResourceData(t, map[string]interface{}{
+		"signing_url":               "https://vault.example.com/v1/transit/sign/zscaler-oneapi",
+		"signing_mode":              remotesign.ModeVaultTransit,
+		"signing_key_id":            "key-1",
+		"signing_auth_method":       remotesign.AuthMethodVaultJWT,
+		"signing_auth_mount":        "jwt",
+		"signing_vault_role":        "zscaler-terraform",
+		"signing_jwt_token_file":    "/var/run/secrets/tokens/vault",
+		"signing_vault_namespace":   "admin",
+		"signing_vault_key_version": 2,
+		"signing_request_timeout":   15,
+		"signing_headers":           map[string]interface{}{"X-Request-Source": "terraform"},
+	})
+
+	config := signingConfigFromResourceData(data)
+	if !config.IsConfigured() {
+		t.Fatal("signing configuration was not detected")
+	}
+	if config.URL != "https://vault.example.com/v1/transit/sign/zscaler-oneapi" {
+		t.Errorf("URL = %q", config.URL)
+	}
+	if config.Role != "zscaler-terraform" || config.JWTTokenFile != "/var/run/secrets/tokens/vault" {
+		t.Errorf("workload identity settings were not mapped: %+v", config)
+	}
+	if config.Namespace != "admin" || config.KeyVersion != 2 {
+		t.Errorf("Vault settings were not mapped: %+v", config)
+	}
+	if config.RequestTimeout != 15*time.Second {
+		t.Errorf("RequestTimeout = %s, want 15s", config.RequestTimeout)
+	}
+	if config.Headers["X-Request-Source"] != "terraform" {
+		t.Errorf("headers were not mapped: %+v", config.Headers)
+	}
+
+	// The configuration must be accepted by the SDK.
+	if _, err := remotesign.New(config); err != nil {
+		t.Errorf("the SDK rejected the configuration: %v", err)
+	}
+}
