+func TestSigningConfigFallsBackToEnvironment(t *testing.T) {
+	t.Setenv("ZSCALER_SIGNING_URL", "https://vault.example.com/v1/transit/sign/from-env")
+	t.Setenv("VAULT_TOKEN", "hvs.from-env")
+	t.Setenv("VAULT_NAMESPACE", "admin")
+	t.Setenv("VAULT_ROLE", "role-from-env")
+	t.Setenv("ZSCALER_SIGNING_KEY_VERSION", "7")
+
+	config := signingConfigFromResourceData(signingResourceData(t, map[string]interface{}{}))
+	if config.URL != "https://vault.example.com/v1/transit/sign/from-env" {
+		t.Errorf("URL = %q, want the value from ZSCALER_SIGNING_URL", config.URL)
+	}
+	if config.Token != "hvs.from-env" {
+		t.Errorf("Token = %q, want the value from VAULT_TOKEN", config.Token)
+	}
+	if config.Namespace != "admin" {
+		t.Errorf("Namespace = %q, want the value from VAULT_NAMESPACE", config.Namespace)
+	}
+	if config.Role != "role-from-env" {
+		t.Errorf("Role = %q, want the value from VAULT_ROLE", config.Role)
+	}
+	if config.KeyVersion != 7 {
+		t.Errorf("KeyVersion = %d, want 7", config.KeyVersion)
+	}
+}
