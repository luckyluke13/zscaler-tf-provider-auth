+func TestSigningAttributeValidation(t *testing.T) {
+	providerSchema := ZPAProvider().Schema
+	cases := map[string]struct {
+		value   string
+		wantErr bool
+	}{
+		"signing_mode":            {value: "vault_transit"},
+		"signing_auth_method":     {value: "vault_jwt"},
+		"signing_request_format":  {value: "azure_keyvault"},
+		"signing_response_format": {value: "signature"},
+	}
+	for attribute, tc := range cases {
+		validate := providerSchema[attribute].ValidateFunc
+		if validate == nil {
+			t.Fatalf("%s has no validation", attribute)
+		}
+		if _, errs := validate(tc.value, attribute); len(errs) != 0 {
+			t.Errorf("%s rejected the valid value %q: %v", attribute, tc.value, errs)
+		}
+		if _, errs := validate("nonsense", attribute); len(errs) == 0 {
+			t.Errorf("%s accepted an invalid value", attribute)
+		}
+	}
+}
