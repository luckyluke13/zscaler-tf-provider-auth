index 0000000..a1ce6bb
--- /dev/null
+++ b/zpa/signing.go
@@ -0,0 +1,234 @@
+package zpa
+
+import (
+	"fmt"
+	"os"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/hashicorp/terraform-plugin-sdk/v2/helper/schema"
+	"github.com/zscaler/zscaler-sdk-go/v3/zscaler/remotesign"
+)
+
+// Remote client assertion signing.
+//
+// OneAPI accepts a JWT client assertion signed by the private key of a
+// registered public key. The assertion is assembled by the provider and only
+// its signature has to be produced by the holder of the private key, so that
+// signature can be delegated to the key store that generated the key: Vault
+// Transit, a cloud KMS, or any HTTP signing endpoint. The provider then never
+// needs the raw key, which means the key never has to be created as exportable.
+//
+// These attributes are shared verbatim by the ZIA and ZPA providers.
+
+// signingSchema returns the provider attributes that configure remote signing.
+func signingSchema() map[string]*schema.Schema {
+	return map[string]*schema.Schema{
+		"signing_url": {
+			Type:          schema.TypeString,
+			Optional:      true,
+			ConflictsWith: []string{"private_key", "client_secret"},
+			Description: "URL of the signing service that signs the OAuth2 client assertion, for example a Vault Transit sign endpoint " +
+				"(https://vault.example.com/v1/transit/sign/zscaler-oneapi). Used instead of `private_key` so the private key never " +
+				"leaves the key store. Can also be sourced from `ZSCALER_SIGNING_URL`.",
+		},
+		"signing_mode": {
+			Type:         schema.TypeString,
+			Optional:     true,
+			ValidateFunc: validateSigningValue("signing_mode", remotesign.ModeVaultTransit, remotesign.ModeHTTP),
+			Description: "Protocol spoken to the signing service: `vault_transit` or `http`. Inferred from `signing_url` when omitted. " +
+				"Can also be sourced from `ZSCALER_SIGNING_MODE`.",
+		},
+		"signing_key_id": {
+			Type:     schema.TypeString,
+			Optional: true,
+			Description: "Value of the `kid` header of the generated client assertion. Only needed when the Zscaler tenant has several " +
+				"registered public keys. Can also be sourced from `ZSCALER_SIGNING_KEY_ID`.",
+		},
+		"signing_token": {
+			Type:      schema.TypeString,
+			Optional:  true,
+			Sensitive: true,
+			Description: "Static credential presented to the signing service: an `X-Vault-Token` in `vault_transit` mode, a bearer token " +
+				"in `http` mode. Can also be sourced from `ZSCALER_SIGNING_TOKEN` or `VAULT_TOKEN`.",
+		},
+		"signing_auth_method": {
+			Type:     schema.TypeString,
+			Optional: true,
+			ValidateFunc: validateSigningValue("signing_auth_method",
+				remotesign.AuthMethodNone, remotesign.AuthMethodToken, remotesign.AuthMethodVaultJWT, remotesign.AuthMethodVaultAppRole),
+			Description: "How to authenticate to the signing service: `none`, `token`, `vault_jwt` (workload identity) or `vault_approle`. " +
+				"Inferred from the other signing attributes when omitted. Can also be sourced from `ZSCALER_SIGNING_AUTH_METHOD`.",
+		},
+		"signing_auth_mount": {
+			Type:     schema.TypeString,
+			Optional: true,
+			Description: "Vault auth mount path used to log in, defaulting to `jwt` for `vault_jwt` and `approle` for `vault_approle`. " +
+				"Set it to `kubernetes` to log in through the Kubernetes auth method. Can also be sourced from `ZSCALER_SIGNING_AUTH_MOUNT`.",
+		},
+		"signing_vault_role": {
+			Type:     schema.TypeString,
+			Optional: true,
+			Description: "Vault role to log in as when using workload identity or AppRole authentication. Can also be sourced from " +
+				"`ZSCALER_SIGNING_ROLE` or `VAULT_ROLE`.",
+		},
+		"signing_jwt": {
+			Type:      schema.TypeString,
+			Optional:  true,
+			Sensitive: true,
+			Description: "Workload identity token presented to the Vault JWT/OIDC auth method. Prefer `signing_jwt_token_file` for " +
+				"rotating tokens. Can also be sourced from `ZSCALER_SIGNING_JWT`.",
+		},
+		"signing_jwt_token_file": {
+			Type:     schema.TypeString,
+			Optional: true,
+			Description: "Path to the workload identity token presented to the Vault JWT/OIDC auth method, for example the projected " +
+				"service account token of the pod running Terraform. It is re-read on every login so rotated tokens keep working. " +
+				"Can also be sourced from `ZSCALER_SIGNING_JWT_TOKEN_FILE` or `VAULT_JWT_TOKEN_FILE`.",
+		},
+		"signing_role_id": {
+			Type:        schema.TypeString,
+			Optional:    true,
+			Sensitive:   true,
+			Description: "Vault AppRole role ID. Can also be sourced from `ZSCALER_SIGNING_ROLE_ID` or `VAULT_ROLE_ID`.",
+		},
+		"signing_secret_id": {
+			Type:        schema.TypeString,
+			Optional:    true,
+			Sensitive:   true,
+			Description: "Vault AppRole secret ID. Can also be sourced from `ZSCALER_SIGNING_SECRET_ID` or `VAULT_SECRET_ID`.",
+		},
+		"signing_vault_namespace": {
+			Type:     schema.TypeString,
+			Optional: true,
+			Description: "Vault namespace sent as `X-Vault-Namespace`. HCP Vault Dedicated clusters normally need `admin`. " +
+				"Can also be sourced from `ZSCALER_SIGNING_NAMESPACE` or `VAULT_NAMESPACE`.",
+		},
+		"signing_vault_address": {
+			Type:     schema.TypeString,
+			Optional: true,
+			Description: "Base address of the Vault cluster used for login calls. Derived from `signing_url` when omitted. " +
+				"Can also be sourced from `ZSCALER_SIGNING_VAULT_ADDRESS` or `VAULT_ADDR`.",
+		},
+		"signing_vault_key_version": {
+			Type:     schema.TypeInt,
+			Optional: true,
+			Description: "Pins the Vault Transit key version used to sign. Defaults to the latest version. Can also be sourced from " +
+				"`ZSCALER_SIGNING_KEY_VERSION`.",
+		},
+		"signing_request_format": {
+			Type:         schema.TypeString,
+			Optional:     true,
+			ValidateFunc: validateSigningValue("signing_request_format", remotesign.RequestFormatGeneric, remotesign.RequestFormatAzureKeyVault),
+			Description: "Request body shape in `http` mode: `generic` or `azure_keyvault`. Can also be sourced from " +
+				"`ZSCALER_SIGNING_REQUEST_FORMAT`.",
+		},
+		"signing_response_format": {
+			Type:         schema.TypeString,
+			Optional:     true,
+			ValidateFunc: validateSigningValue("signing_response_format", remotesign.ResponseFormatSignature, remotesign.ResponseFormatJWT),
+			Description: "What the signing service returns in `http` mode: `signature` (default) or `jwt`, for a service that mints the " +
+				"whole assertion. Can also be sourced from `ZSCALER_SIGNING_RESPONSE_FORMAT`.",
+		},
+		"signing_signature_field": {
+			Type:     schema.TypeString,
+			Optional: true,
+			Description: "Dotted path to the signature in the signing response, for example `data.signature`. Detected automatically when " +
+				"omitted. Can also be sourced from `ZSCALER_SIGNING_SIGNATURE_FIELD`.",
+		},
+		"signing_headers": {
+			Type:        schema.TypeMap,
+			Optional:    true,
+			Elem:        &schema.Schema{Type: schema.TypeString},
+			Description: "Extra HTTP headers sent to the signing service.",
+		},
+		"signing_request_timeout": {
+			Type:        schema.TypeInt,
+			Optional:    true,
+			Description: "Timeout in seconds for a single call to the signing service. Defaults to 30. Can also be sourced from `ZSCALER_SIGNING_REQUEST_TIMEOUT`.",
+		},
+	}
+}
+
+// validateSigningValue accepts only the listed values, case-insensitively.
+func validateSigningValue(attribute string, allowed ...string) schema.SchemaValidateFunc {
+	return func(value interface{}, _ string) ([]string, []error) {
+		given, ok := value.(string)
+		if !ok || given == "" {
+			return nil, nil
+		}
+		for _, candidate := range allowed {
+			if strings.EqualFold(given, candidate) {
+				return nil, nil
+			}
+		}
+		return nil, []error{fmt.Errorf("%s must be one of %s, got %q", attribute, strings.Join(allowed, ", "), given)}
+	}
+}
+
+// signingConfigFromResourceData reads the signing attributes, falling back to
+// the documented environment variables.
+func signingConfigFromResourceData(d *schema.ResourceData) remotesign.Config {
+	str := func(attribute string, envNames ...string) string {
+		if val, ok := d.GetOk(attribute); ok {
+			if value, ok := val.(string); ok && value != "" {
+				return value
+			}
+		}
+		for _, name := range envNames {
+			if value := os.Getenv(name); value != "" {
+				return value
+			}
+		}
+		return ""
+	}
+	integer := func(attribute string, envNames ...string) int {
+		if val, ok := d.GetOk(attribute); ok {
+			if value, ok := val.(int); ok && value != 0 {
+				return value
+			}
+		}
+		for _, name := range envNames {
+			if raw := os.Getenv(name); raw != "" {
+				if value, err := strconv.Atoi(raw); err == nil {
+					return value
+				}
+			}
+		}
+		return 0
+	}
+
+	config := remotesign.Config{
+		URL:            str("signing_url", "ZSCALER_SIGNING_URL"),
+		Mode:           str("signing_mode", "ZSCALER_SIGNING_MODE"),
+		KeyID:          str("signing_key_id", "ZSCALER_SIGNING_KEY_ID"),
+		Token:          str("signing_token", "ZSCALER_SIGNING_TOKEN", "VAULT_TOKEN"),
+		AuthMethod:     str("signing_auth_method", "ZSCALER_SIGNING_AUTH_METHOD"),
+		AuthMount:      str("signing_auth_mount", "ZSCALER_SIGNING_AUTH_MOUNT"),
+		Role:           str("signing_vault_role", "ZSCALER_SIGNING_ROLE", "VAULT_ROLE"),
+		JWT:            str("signing_jwt", "ZSCALER_SIGNING_JWT"),
+		JWTTokenFile:   str("signing_jwt_token_file", "ZSCALER_SIGNING_JWT_TOKEN_FILE", "VAULT_JWT_TOKEN_FILE"),
+		RoleID:         str("signing_role_id", "ZSCALER_SIGNING_ROLE_ID", "VAULT_ROLE_ID"),
+		SecretID:       str("signing_secret_id", "ZSCALER_SIGNING_SECRET_ID", "VAULT_SECRET_ID"),
+		Namespace:      str("signing_vault_namespace", "ZSCALER_SIGNING_NAMESPACE", "VAULT_NAMESPACE"),
+		VaultAddress:   str("signing_vault_address", "ZSCALER_SIGNING_VAULT_ADDRESS", "VAULT_ADDR"),
+		KeyVersion:     integer("signing_vault_key_version", "ZSCALER_SIGNING_KEY_VERSION"),
+		RequestFormat:  str("signing_request_format", "ZSCALER_SIGNING_REQUEST_FORMAT"),
+		ResponseFormat: str("signing_response_format", "ZSCALER_SIGNING_RESPONSE_FORMAT"),
+		SignatureField: str("signing_signature_field", "ZSCALER_SIGNING_SIGNATURE_FIELD"),
+	}
+
+	if seconds := integer("signing_request_timeout", "ZSCALER_SIGNING_REQUEST_TIMEOUT"); seconds > 0 {
+		config.RequestTimeout = time.Duration(seconds) * time.Second
+	}
+	if raw, ok := d.GetOk("signing_headers"); ok {
+		if headers, ok := raw.(map[string]interface{}); ok && len(headers) > 0 {
+			config.Headers = make(map[string]string, len(headers))
+			for name, value := range headers {
+				config.Headers[name] = fmt.Sprintf("%v", value)
+			}
+		}
+	}
+	return config
+}
