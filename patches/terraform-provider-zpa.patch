+func TestSigningSchemaIsRegistered(t *testing.T) {
+	providerSchema := ZPAProvider().Schema
+	for name := range signingSchema() {
+		if _, ok := providerSchema[name]; !ok {
+			t.Errorf("provider schema is missing the %q attribute", name)
+		}
+	}
+
+	// signing_url and the local credential attributes are mutually exclusive.
+	for _, attribute := range []string{"client_secret", "private_key"} {
+		conflicts := providerSchema[attribute].ConflictsWith
+		found := false
+		for _, conflict := range conflicts {
+			if conflict == "signing_url" {
+				found = true
+			}
+		}
+		if !found {
+			t.Errorf("%s does not conflict with signing_url (got %v)", attribute, conflicts)
+		}
+	}
+	if len(providerSchema["signing_url"].ConflictsWith) != 2 {
+		t.Errorf("signing_url should conflict with both client_secret and private_key, got %v", providerSchema["signing_url"].ConflictsWith)
+	}
+	if !providerSchema["signing_token"].Sensitive {
+		t.Error("signing_token must be marked sensitive")
+	}
+	for _, attribute := range []string{"signing_jwt", "signing_role_id", "signing_secret_id"} {
+		if !providerSchema[attribute].Sensitive {
+			t.Errorf("%s must be marked sensitive", attribute)
+		}
+	}
+}
